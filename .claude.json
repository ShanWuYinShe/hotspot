{
  "project": {
    "name": "HotSpot",
    "description": "基于地理位置的社交应用 (Monorepo)",
    "languages": ["Rust", "TypeScript", "ArkTS"]
  },
  "structure": {
    "backend": {
      "path": "backend",
      "language": "Rust",
      "testCommand": "cargo test",
      "buildCommand": "cargo build --release",
      "typecheckCommand": "cargo check"
    },
    "frontend": {
      "path": "frontend_svelte",
      "language": "TypeScript",
      "testCommand": "pnpm check && pnpm build --mode test",
      "buildCommand": "pnpm build",
      "typecheckCommand": "pnpm check"
    },
    "harmony": {
      "path": "harmonyapp",
      "language": "ArkTS",
      "note": "hvigorw 编译命令禁止 Agent 执行，必须由用户手动运行；ohpm（依赖安装）和 codelinter（代码检查）可由 Agent 直接执行，执行前须先 git add -A 保护改动；禁止在该流程中使用 git stash push/pop"
    }
  },
  "docs": {
    "apiSpec": "spec",
    "agents": "AGENTS.md"
  },
  "deployment": {
    "path": "deploy",
    "composeFile": "deploy/docker-compose.runtime.yml"
  },
  "commands": {
    "install": {
      "backend": "cd backend && cargo build",
      "frontend": "cd frontend_svelte && pnpm install",
      "harmony": "echo '执行前先保护改动: git add -A；然后执行: cd harmonyapp && ohpm install --all（hvigorw 编译命令禁止 Agent 执行，须由用户手动运行；不要使用 git stash push/pop）'",
      "all": "cd backend && cargo build && cd ../frontend_svelte && pnpm install"
    },
    "dev": {
      "backend": "cd backend && cargo run",
      "frontend": "cd frontend_svelte && pnpm dev"
    },
    "typecheck": {
      "backend": "cd backend && cargo check",
      "frontend": "cd frontend_svelte && pnpm check"
    }
  }
}
