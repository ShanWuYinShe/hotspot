# 数据库配置
DATABASE_URL=postgresql://hotspot:hotspot@localhost:5432/hotspot

# Redis 配置
REDIS_URL=redis://localhost:6379

# JWT 配置
JWT_SECRET=your-secret-key-change-this-in-production
JWT_ACCESS_TOKEN_EXPIRATION=3600
JWT_REFRESH_TOKEN_EXPIRATION=2592000

# Web: refresh_token 使用 HttpOnly Cookie，下列 Origin 白名单用于 refresh_token 的 Origin/Referer 校验与 CORS
# 多个用逗号分隔
CORS_ALLOW_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# 服务器配置
SERVER_HOST=0.0.0.0
SERVER_PORT=5496

# 日志配置
RUST_LOG=info,hotspot_backend=debug

# 文件上传配置
MAX_UPLOAD_SIZE=10485760

# S3 / MinIO 配置（MinIO 模拟 AWS S3，未来可无感切换到公有云）
# 注意：以下配置均为必填项
#
# 核心配置说明：
# - S3_ENDPOINT: AWS SDK 内部连接地址（必须是完整 URL）
# - S3_BUCKET: bucket 名称（MinIO 和 S3 都需要）
# - S3_PUBLIC_BASE: 对外返回的 presigned URL 前缀（必填）
#   AWS SDK 会生成完整的 path（包含 bucket），后端只需简单拼接 S3_PUBLIC_BASE + path_and_query
#
# 场景 1：本地开发（MinIO + Nginx）⭐ 推荐
#   S3_ENDPOINT=http://localhost:9000
#   S3_BUCKET=hotspot
#   S3_PUBLIC_BASE=/s3
#   → AWS SDK 生成: /hotspot/uploads/123/abc.jpg?signature=xxx
#   → 后端返回: /s3/hotspot/uploads/123/abc.jpg?signature=xxx
#   → Nginx 配置: location /s3/ { proxy_pass http://localhost:9000/; }
#   → Nginx 转发: http://localhost:9000/hotspot/uploads/123/abc.jpg?signature=xxx ✅
#
# 场景 2：生产环境（AWS S3）
#   S3_ENDPOINT=https://s3.us-west-2.amazonaws.com
#   S3_BUCKET=hotspot-production
#   S3_PUBLIC_BASE=https://s3.us-west-2.amazonaws.com
#   → AWS SDK 生成: /hotspot-production/uploads/123/abc.jpg?signature=xxx
#   → 后端返回: https://s3.us-west-2.amazonaws.com/hotspot-production/uploads/123/abc.jpg?signature=xxx
#   → 客户端直连 S3 ✅
#
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=hotspot
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PUBLIC_BASE=/s3

# 频率限制配置
RATE_LIMIT_GLOBAL_PER_HOUR=1000
RATE_LIMIT_USER_PER_HOUR=5000

# 超级管理员 bootstrap（必需）
# 系统启动时会检查是否存在超级管理员：
# - 如果不存在且 SUPER_ADMIN_PASSWORD 未设置，系统将阻塞启动
# - 如果不存在但 SUPER_ADMIN_PASSWORD 已设置，将自动创建/升级为超级管理员
# 生产环境必须设置强密码
SUPER_ADMIN_LOGIN_ID=superadmin
SUPER_ADMIN_PASSWORD=change-me-in-prod
