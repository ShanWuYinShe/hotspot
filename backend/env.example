# 数据库配置
DATABASE_URL=postgresql://hotspot:hotspot@localhost:5432/hotspot

# Redis 配置
REDIS_URL=redis://localhost:6379

# JWT 配置
JWT_SECRET=your-secret-key-change-this-in-production
JWT_ACCESS_TOKEN_EXPIRATION=3600
JWT_REFRESH_TOKEN_EXPIRATION=2592000

# Web: refresh_token 使用 HttpOnly Cookie，下列 Origin 白名单用于 refresh_token 的 Origin/Referer 校验与 CORS
# 多个用逗号分隔
CORS_ALLOW_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# 服务器配置
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# 日志配置
RUST_LOG=info,hotspot_backend=debug

# 文件上传配置
MAX_UPLOAD_SIZE=10485760

# S3 / MinIO 配置
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=hotspot
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# 如果使用 MinIO 本地开发，public url 需要是前端浏览器可访问的地址
S3_PUBLIC_URL=http://localhost:9000/hotspot

# 频率限制配置
RATE_LIMIT_GLOBAL_PER_HOUR=1000
RATE_LIMIT_USER_PER_HOUR=5000

# 超级管理员 bootstrap（必需）
# 系统启动时会检查是否存在超级管理员：
# - 如果不存在且 SUPER_ADMIN_PASSWORD 未设置，系统将阻塞启动
# - 如果不存在但 SUPER_ADMIN_PASSWORD 已设置，将自动创建/升级为超级管理员
# 生产环境必须设置强密码
SUPER_ADMIN_LOGIN_ID=superadmin
SUPER_ADMIN_PASSWORD=change-me-in-prod
