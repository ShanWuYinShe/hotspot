# 数据库配置
DATABASE_URL=postgresql://hotspot:hotspot@localhost:5432/hotspot

# Redis 配置
REDIS_URL=redis://localhost:6379

# ID 生成器配置（分布式建议开启 Redis 自动分配）
ID_NODE_ID=0
ID_NODE_ID_STRICT=true
ID_NODE_ID_ALLOCATE_WITH_REDIS=false
ID_NODE_ID_REDIS_KEY_PREFIX=hotspot:id_node:lease
ID_NODE_ID_REDIS_LEASE_TTL_SECS=90
ID_NODE_ID_REDIS_RENEW_INTERVAL_SECS=30
ID_NODE_ID_REDIS_FATAL_ON_LOSS=true

# 测试专用 PostgreSQL / Redis（不要复用运行时实例）
TEST_DATABASE_URL=postgresql://hotspot:hotspot@127.0.0.1:5432/hotspot_test
TEST_REDIS_URL=redis://127.0.0.1:6380/0

# JWT 配置
JWT_SECRET=your-secret-key-change-this-in-production
JWT_ACCESS_TOKEN_EXPIRATION=1800
JWT_REFRESH_TOKEN_EXPIRATION=1209600

# 服务器配置
SERVER_HOST=0.0.0.0
SERVER_PORT=5496
COOKIE_SECURE=false

# 数据库连接池
DB_POOL_MAX_CONNECTIONS=20
DB_POOL_MIN_CONNECTIONS=5
DB_POOL_ACQUIRE_TIMEOUT_SECS=10
DB_POOL_IDLE_TIMEOUT_SECS=600
DB_POOL_MAX_LIFETIME_SECS=1800
DB_POOL_TEST_BEFORE_ACQUIRE=true

# 文件上传配置
MAX_UPLOAD_SIZE=10485760

# 限流配置
RATE_LIMIT_GLOBAL_PER_HOUR=20000
RATE_LIMIT_USER_PER_5MINUTES=500
RATE_LIMIT_USER_PER_HOUR=5000
RATE_LIMIT_FAIL_OPEN=true
RATE_LIMIT_REGISTER_PER_10MINUTES=10
RATE_LIMIT_LOGIN_PER_10MINUTES=30
RATE_LIMIT_AUTH_RESET_PER_10MINUTES=10
RATE_LIMIT_GUEST_PER_10MINUTES=60
RATE_LIMIT_REFRESH_PER_10MINUTES=120
RATE_LIMIT_MOMENTS_CREATE_PER_MINUTE=20
RATE_LIMIT_COMMENTS_CREATE_PER_MINUTE=60
RATE_LIMIT_REPORTS_CREATE_PER_HOUR=10

# 超级管理员 bootstrap
SUPER_ADMIN_LOGIN_ID=superadmin
SUPER_ADMIN_PASSWORD=change-me-in-prod

# S3 / MinIO 配置
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=hotspot
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE=/s3

# 密码重置验证码外部投递（可选）
AUTH_RESET_DELIVERY_WEBHOOK_URL=
AUTH_RESET_DELIVERY_WEBHOOK_TOKEN=
AUTH_RESET_DELIVERY_TIMEOUT_MS=3000
