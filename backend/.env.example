# ============================================
# HotSpot Backend Configuration Example
# ============================================
# 复制此文件为 .env 并修改配置值
# cp .env.example .env
# 测试环境可直接使用 .env.test（已提供默认测试配置模板）

# ============================================
# 数据库配置 (Database)
# ============================================
DATABASE_URL=postgresql://hotspot:password@localhost:5432/hotspot

# 数据库连接池配置（适配分布式部署）
# 假设 PostgreSQL max_connections=100，部署 3 个实例
# 每个实例最大连接数 = (100 - 预留20) / 3 ≈ 26，保守设置为 20
DB_POOL_MAX_CONNECTIONS=20
DB_POOL_MIN_CONNECTIONS=5
DB_POOL_ACQUIRE_TIMEOUT_SECS=10
DB_POOL_IDLE_TIMEOUT_SECS=600
DB_POOL_MAX_LIFETIME_SECS=1800
DB_POOL_TEST_BEFORE_ACQUIRE=true

# ============================================
# Redis 配置 (Cache & Session)
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# ID 生成器配置 (Snowflake / Redis 租约)
# ============================================
# 单机或静态分配：手工指定 node_id（0-1023）
ID_NODE_ID=0
# 生产环境建议开启严格校验（node_id 缺失/非法直接启动失败）
ID_NODE_ID_STRICT=true

# 开启后使用 Redis 自动分配 node_id（适合多实例/弹性扩容）
ID_NODE_ID_ALLOCATE_WITH_REDIS=false
# 租约前缀（最终 key 形如 hotspot:id_node:lease:17）
ID_NODE_ID_REDIS_KEY_PREFIX=hotspot:id_node:lease
# 可选：租约 owner 标识；为空时自动使用 HOSTNAME + PID + UUID 组合
ID_NODE_ID_REDIS_OWNER=
# 租约 TTL（秒）
ID_NODE_ID_REDIS_LEASE_TTL_SECS=90
# 续租周期（秒，必须小于 TTL）
ID_NODE_ID_REDIS_RENEW_INTERVAL_SECS=30
# 续租失败后是否强制退出（建议 true，避免 ID 冲突）
ID_NODE_ID_REDIS_FATAL_ON_LOSS=true

# 测试专用 PostgreSQL / Redis（不要复用运行时实例）
TEST_DATABASE_URL=postgresql://hotspot:password@127.0.0.1:5432/hotspot_test
TEST_REDIS_URL=redis://127.0.0.1:6380/0

# ============================================
# JWT 配置 (Authentication)
# ============================================
# JWT 密钥（生产环境必须使用强随机字符串）
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Access Token 过期时间（秒）- 默认 30 分钟（符合业内最佳实践）
JWT_ACCESS_TOKEN_EXPIRATION=1800

# Refresh Token 过期时间（秒）- 默认 14 天（基于用户活跃度的合理时长）
JWT_REFRESH_TOKEN_EXPIRATION=1209600

# ============================================
# 服务器配置 (Server)
# ============================================
SERVER_HOST=0.0.0.0
SERVER_PORT=5496

# ============================================
# 文件上传配置 (Upload Limits)
# ============================================
# 最大上传文件大小（字节）- 默认 10MB
MAX_UPLOAD_SIZE=10485760

# ============================================
# Rate Limit 配置 (防滥用和DDoS攻击)
# ============================================
# 注意：合理配置限流值，平衡用户体验和安全性
# 
# 全局限流（小时窗口）
# - 默认：20000 次/小时（约 5.5 次/秒）
RATE_LIMIT_GLOBAL_PER_HOUR=20000

# 用户级限流 - 短期窗口（防止突发攻击）
# - 单用户每 5 分钟请求限制
# - 触发后等待时间：5 分钟（用户体验友好）
# - 默认：500 次/5分钟（约 1.67 次/秒）
RATE_LIMIT_USER_PER_5MINUTES=500

# 用户级限流 - 长期窗口（补充防护）
# - 单用户每小时请求限制
# - 触发后等待时间：1 小时（极少触发）
# - 默认：5000 次/小时（约 1.39 次/秒）
RATE_LIMIT_USER_PER_HOUR=5000

# 限流降级策略（Redis 故障时的行为）
# - true: fail-open（允许请求通过，优先保证可用性）
# - false: fail-closed（拒绝请求，优先保证安全性）
# - 默认：true（推荐，避免 Redis 故障导致服务完全不可用）
RATE_LIMIT_FAIL_OPEN=true

# ============================================
# 端点级限流配置 (Endpoint Rate Limits)
# ============================================
# 用户注册 - 每 10 分钟限制（防止批量注册）
RATE_LIMIT_REGISTER_PER_10MINUTES=10

# 用户登录 - 每 10 分钟限制（防止暴力破解）
RATE_LIMIT_LOGIN_PER_10MINUTES=30

# 密码重置请求 - 每 10 分钟限制（防止验证码轰炸）
RATE_LIMIT_AUTH_RESET_PER_10MINUTES=10

# 游客登录 - 每 10 分钟限制
RATE_LIMIT_GUEST_PER_10MINUTES=60

# Token 刷新 - 每 10 分钟限制
RATE_LIMIT_REFRESH_PER_10MINUTES=120

# 业务相关接口限流（按用户ID）

# 创建瞬间 - 每分钟限制（防止刷屏）
RATE_LIMIT_MOMENTS_CREATE_PER_MINUTE=20

# 创建评论 - 每分钟限制（防止刷屏）
RATE_LIMIT_COMMENTS_CREATE_PER_MINUTE=60

# 创建举报 - 每小时限制（防止恶意举报）
RATE_LIMIT_REPORTS_CREATE_PER_HOUR=10

# ============================================
# 超级管理员配置 (Super Admin Bootstrap)
# ============================================
# 首次启动时自动创建超级管理员账号
# 如果未设置密码，则不会自动创建

# 超级管理员登录ID（可选，默认 superadmin）
SUPER_ADMIN_LOGIN_ID=superadmin

# 超级管理员初始密码（生产环境必须设置强密码）
SUPER_ADMIN_PASSWORD=change-this-strong-password

# ============================================
# S3/MinIO 配置 (Object Storage)
# ============================================
# 统一使用 S3 API（MinIO 兼容 AWS S3）

# S3 服务端点
# - 开发环境：http://localhost:9000
# - 生产环境：https://s3.your-domain.com
S3_ENDPOINT=http://localhost:9000

# S3 区域（MinIO 可以任意设置）
S3_REGION=us-east-1

# S3 存储桶名称
S3_BUCKET=hotspot

# S3 访问密钥（必须设置）
S3_ACCESS_KEY=minioadmin

# S3 密钥（必须设置）
S3_SECRET_KEY=minioadmin

# 强制路径风格（MinIO 推荐 true，AWS S3 通常为 false）
S3_FORCE_PATH_STYLE=true

# S3 公开访问 URL 前缀（必须设置）
# - 相对路径（如 /s3）：用于本地 MinIO，通过 Nginx 转发
# - 完整 URL（如 https://cdn.example.com）：用于生产环境 CDN
S3_PUBLIC_BASE=/s3

# ============================================
# 密码重置验证码投递（可选）
# ============================================
# 对接外部短信/邮件网关的 Webhook（留空则仅写日志，不走外部投递）
AUTH_RESET_DELIVERY_WEBHOOK_URL=
# 可选：Webhook Bearer Token
AUTH_RESET_DELIVERY_WEBHOOK_TOKEN=
# Webhook 请求超时（毫秒）
AUTH_RESET_DELIVERY_TIMEOUT_MS=3000

# ============================================
# 配置说明
# ============================================
# 
# 1. Rate Limit 配置建议：
#    - IP限制应大于单用户限制，考虑共享IP场景
#    - 可以通过管理后台实时调整，无需重启服务
#    - 监控触发频率，根据实际情况调整阈值
#
# 2. JWT 配置建议：
#    - JWT_SECRET 必须使用强随机字符串（32+ 字符）
#    - 生产环境不要使用默认值
#    - Access Token 过期时间不宜过长
#
# 3. S3 配置建议：
#    - 生产环境必须使用强密码
#    - 建议使用 CDN 加速静态资源访问
#    - S3_PUBLIC_BASE 必须配置为客户端可访问的 URL
#
# 4. 超级管理员建议：
#    - 首次部署后立即修改默认密码
#    - 不要在代码仓库中提交 .env 文件
#    - 定期更换管理员密码
#
# ============================================
