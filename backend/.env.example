# ============================================================
# HotSpot Backend 环境变量配置示例
#
# 使用方法：
# 1. 复制此文件为 .env
# 2. 填入实际的配置值
# ============================================================

# ============ 必填配置 ============

# 数据库连接 URL
DATABASE_URL=postgres://username:password@localhost:5432/hotspot

# JWT 密钥（用于生成和验证 token）
# 生成方式：openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-at-least-32-chars

# ============ 可选配置 ============

# Redis 连接 URL（默认：redis://localhost:6379）
REDIS_URL=redis://localhost:6379

# 服务器配置
SERVER_HOST=0.0.0.0
SERVER_PORT=5496

# JWT Token 有效期（秒）
JWT_ACCESS_TOKEN_EXPIRATION=3600      # Access Token 有效期，默认 1 小时
JWT_REFRESH_TOKEN_EXPIRATION=2592000  # Refresh Token 有效期，默认 30 天

# 文件上传配置
MAX_UPLOAD_SIZE=10485760              # 最大上传大小，默认 10MB
UPLOAD_DIR=./uploads                  # 上传目录

# ============================================================
# 速率限制配置
# ============================================================
# 所有端点限速值均可通过环境变量配置，默认值与硬编码值一致

# 全局和用户级限速
RATE_LIMIT_GLOBAL_PER_HOUR=1000           # 全局每小时请求限制
RATE_LIMIT_USER_PER_HOUR=5000             # 单用户每小时请求限制

# 认证端点限速
RATE_LIMIT_SEND_CODE_PER_MINUTE=5          # 验证码发送：5次/分钟
RATE_LIMIT_VERIFY_CODE_PER_10MINUTES=30    # 验证码验证：30次/10分钟
RATE_LIMIT_REGISTER_PER_10MINUTES=10       # 注册：10次/10分钟
RATE_LIMIT_LOGIN_PER_10MINUTES=30          # 登录：30次/10分钟
RATE_LIMIT_GUEST_PER_10MINUTES=60          # 访客创建：60次/10分钟
RATE_LIMIT_REFRESH_PER_10MINUTES=120       # Token 刷新：120次/10分钟
RATE_LIMIT_RESET_REQUEST_PER_MINUTE=5       # 密码重置请求：5次/分钟
RATE_LIMIT_RESET_VERIFY_PER_10MINUTES=20    # 密码重置验证：20次/10分钟
RATE_LIMIT_RESET_PER_10MINUTES=10          # 密码重置：10次/10分钟

# 内容创建限速
RATE_LIMIT_MOMENTS_CREATE_PER_MINUTE=20     # 创建瞬间：20次/分钟
RATE_LIMIT_COMMENTS_CREATE_PER_MINUTE=60     # 创建评论：60次/分钟
RATE_LIMIT_REPORTS_CREATE_PER_HOUR=10       # 举报：10次/小时

# ============ 第三方服务 ============

# 高德地图 Web 服务 API Key（用于逆地理编码）
# 申请地址：https://console.amap.com/dev/key/app
# 注意：请使用「Web 服务」类型的 Key，不是「Web 端」
AMAP_KEY=your-amap-web-service-key

# S3 / MinIO 配置（对象存储）
# MinIO + Nginx 代理示例：
# - S3_ENDPOINT=http://localhost:9000
# - S3_PUBLIC_BASE=/s3
# - S3_FORCE_PATH_STYLE=true
# AWS S3 示例：
# - S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# - S3_PUBLIC_BASE=https://hotspot.s3.us-east-1.amazonaws.com
# - S3_FORCE_PATH_STYLE=false
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=hotspot
S3_ACCESS_KEY=your-s3-access-key
S3_SECRET_KEY=your-s3-secret-key
S3_PUBLIC_BASE=/s3
S3_FORCE_PATH_STYLE=true
