# HotSpot backend test environment template
# 用法：测试前可执行 `cp .env.test .env`
# 说明：测试必须使用独立数据库和独立 Redis，不要复用运行时实例

# 基础依赖（测试环境仍使用与运行环境相同的 key，值不同）
DATABASE_URL=postgresql://hotspot:password@127.0.0.1:5432/hotspot_test
REDIS_URL=redis://127.0.0.1:6379/1

# 必填安全配置（测试专用占位，不用于生产）
JWT_SECRET=test-jwt-secret-only-for-local-tests
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PUBLIC_BASE=/s3

# 可选：测试时避免分布式 node_id 误触发
ID_NODE_ID=0
ID_NODE_ID_STRICT=false
ID_NODE_ID_ALLOCATE_WITH_REDIS=false
ID_NODE_ID_REDIS_OWNER=

# 可选：验证码发送链路（本地测试默认关闭外部投递）
AUTH_RESET_DELIVERY_WEBHOOK_URL=
AUTH_RESET_DELIVERY_WEBHOOK_TOKEN=
