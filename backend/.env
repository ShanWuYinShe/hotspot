# 数据库配置
DATABASE_URL=postgresql://liyou@localhost:5432/hotspot_db

# Redis 配置
REDIS_URL=redis://localhost:6379

# JWT 配置
JWT_SECRET=dev-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRATION=3600
JWT_REFRESH_TOKEN_EXPIRATION=2592000

# 服务器配置
SERVER_HOST=0.0.0.0
SERVER_PORT=5496

# 日志配置
# RUST_LOG=info,hotspot_backend=debug

# 文件上传配置
MAX_UPLOAD_SIZE=10485760
UPLOAD_DIR=./uploads

# CORS 配置
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# 频率限制配置
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_REQUESTS_PER_HOUR=1000

# bcrypt 工作因子
BCRYPT_COST=12


SUPER_ADMIN_LOGIN_ID="hotspot_admin"
SUPER_ADMIN_PASSWORD="liyou19890317"

# S3/Minio配置
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=hotspot
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# S3_PUBLIC_BASE 控制 presigned URL 的前缀
# 本地开发推荐设置为 /s3（相对路径），生产环境设置为完整域名
# 例如：S3_PUBLIC_BASE=https://s3.us-west-2.amazonaws.com
S3_PUBLIC_BASE=/s3
