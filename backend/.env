# ============================================
# HotSpot Backend Configuration
# ============================================
# 本地开发环境配置文件
# 请勿将此文件提交到代码仓库

# ============================================
# 数据库配置 (Database)
# ============================================
# PostgreSQL 连接字符串
# 格式: postgresql://用户名:密码@主机:端口/数据库名
DATABASE_URL=postgresql://liyou@localhost:5432/hotspot_db

# 数据库连接池配置（适配分布式部署）
# 假设 PostgreSQL max_connections=100，部署 3 个实例
# 每个实例最大连接数 = (100 - 预留20) / 3 ≈ 26，保守设置为 20
DB_POOL_MAX_CONNECTIONS=20          # 连接池最大连接数（默认：20）
DB_POOL_MIN_CONNECTIONS=5           # 连接池最小连接数（默认：5）
DB_POOL_ACQUIRE_TIMEOUT_SECS=10     # 获取连接超时时间（秒，默认：10）
DB_POOL_IDLE_TIMEOUT_SECS=600       # 空闲连接超时时间（秒，默认：600 = 10分钟）
DB_POOL_MAX_LIFETIME_SECS=1800      # 连接最大生命周期（秒，默认：1800 = 30分钟）
DB_POOL_TEST_BEFORE_ACQUIRE=true    # 获取连接前进行健康检查（默认：true）

# ============================================
# Redis 配置 (Cache & Session)
# ============================================
# Redis 连接字符串
# 格式: redis://主机:端口[/数据库编号]
REDIS_URL=redis://localhost:6379

# ============================================
# JWT 配置 (Authentication)
# ============================================
# JWT 签名密钥（生产环境必须使用强随机字符串，32+ 字符）
# 生成方法: openssl rand -base64 32
JWT_SECRET=dev-secret-key-change-in-production

# Access Token 过期时间（秒）
# 默认：1800 秒（30 分钟），符合业内最佳实践
JWT_ACCESS_TOKEN_EXPIRATION=1800

# Refresh Token 过期时间（秒）
# 默认：1209600 秒（14 天），基于用户活跃度的合理时长
JWT_REFRESH_TOKEN_EXPIRATION=1209600

# ============================================
# 服务器配置 (Server)
# ============================================
# HTTP 服务器监听地址
# 0.0.0.0 = 监听所有网络接口，127.0.0.1 = 仅本地访问
SERVER_HOST=0.0.0.0

# HTTP 服务器监听端口
SERVER_PORT=5496

# ============================================
# 日志配置 (Logging)
# ============================================
# Rust 日志级别配置（可选）
# 取消注释以启用，格式: 全局级别,模块名=级别
# 级别: error, warn, info, debug, trace
# RUST_LOG=info,hotspot_backend=debug

# ============================================
# 文件上传配置 (Upload Limits)
# ============================================
# 最大上传文件大小（字节）
# 默认：10485760 字节（10 MB）
MAX_UPLOAD_SIZE=10485760

# 本地文件上传目录（已弃用，现使用 S3/MinIO）
UPLOAD_DIR=./uploads

# ============================================
# CORS 配置 (跨域资源共享)
# ============================================
# 允许的前端域名列表（逗号分隔）
# 开发环境：本地前端服务地址
# 生产环境：实际部署的前端域名
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ============================================
# Rate Limit 配置（防滥用和DDoS攻击）
# ============================================
# 注意：合理配置限流值，平衡用户体验和安全性

# IP级限流（单IP每小时请求限制）
# 默认：20000 次/小时（约 5.5 次/秒）
# 考虑多用户共享同一IP的场景（公司/学校/家庭网络）
RATE_LIMIT_IP_PER_HOUR=20000

# 用户级限流 - 短期窗口（防止突发攻击）
# 默认：500 次/5分钟（约 1.67 次/秒）
# 触发后等待时间：5 分钟（用户体验友好）
RATE_LIMIT_USER_PER_5MINUTES=500

# 用户级限流 - 长期窗口（补充防护）
# 默认：5000 次/小时（约 1.39 次/秒）
# 触发后等待时间：1 小时（极少触发）
RATE_LIMIT_USER_PER_HOUR=5000

# 限流降级策略（Redis 故障时的行为）
# true: fail-open（允许请求通过，优先保证可用性）
# false: fail-closed（拒绝请求，优先保证安全性）
# 默认：true（推荐，避免 Redis 故障导致服务完全不可用）
RATE_LIMIT_FAIL_OPEN=true

# ============================================
# 端点级限流配置 (Endpoint Rate Limits)
# ============================================
# 认证相关接口限流（按 IP）

# 发送验证码 - 每分钟限制（防止短信轰炸）
RATE_LIMIT_SEND_CODE_PER_MINUTE=5

# 验证验证码 - 每 10 分钟限制（防止暴力破解）
RATE_LIMIT_VERIFY_CODE_PER_10MINUTES=30

# 用户注册 - 每 10 分钟限制（防止批量注册）
RATE_LIMIT_REGISTER_PER_10MINUTES=10

# 用户登录 - 每 10 分钟限制（防止暴力破解）
RATE_LIMIT_LOGIN_PER_10MINUTES=30

# 游客登录 - 每 10 分钟限制
RATE_LIMIT_GUEST_PER_10MINUTES=60

# Token 刷新 - 每 10 分钟限制
RATE_LIMIT_REFRESH_PER_10MINUTES=120

# 请求密码重置 - 每分钟限制（防止短信轰炸）
RATE_LIMIT_RESET_REQUEST_PER_MINUTE=5

# 验证重置验证码 - 每 10 分钟限制
RATE_LIMIT_RESET_VERIFY_PER_10MINUTES=20

# 重置密码 - 每 10 分钟限制
RATE_LIMIT_RESET_PER_10MINUTES=10

# 业务相关接口限流（按用户ID）

# 创建瞬间 - 每分钟限制（防止刷屏）
RATE_LIMIT_MOMENTS_CREATE_PER_MINUTE=20

# 创建评论 - 每分钟限制（防止刷屏）
RATE_LIMIT_COMMENTS_CREATE_PER_MINUTE=60

# 创建举报 - 每小时限制（防止恶意举报）
RATE_LIMIT_REPORTS_CREATE_PER_HOUR=10

# ============================================
# 超级管理员配置 (Super Admin Bootstrap)
# ============================================
# 首次启动时自动创建超级管理员账号
# 如果未设置密码，则不会自动创建

# 超级管理员登录ID
SUPER_ADMIN_LOGIN_ID=hotspot_admin

# 超级管理员初始密码（首次部署后立即修改）
SUPER_ADMIN_PASSWORD=liyou19890317

# ============================================
# S3/MinIO 配置 (Object Storage)
# ============================================
# 统一使用 S3 API（MinIO 兼容 AWS S3）

# S3 服务端点
# 开发环境：http://localhost:9000
# 生产环境：https://s3.your-domain.com
S3_ENDPOINT=http://localhost:9000

# S3 区域（MinIO 可以任意设置）
S3_REGION=us-east-1

# S3 存储桶名称
S3_BUCKET=hotspot

# S3 访问密钥（必须设置，生产环境使用强密码）
S3_ACCESS_KEY=minioadmin

# S3 密钥（必须设置，生产环境使用强密码）
S3_SECRET_KEY=minioadmin

# 强制路径风格（MinIO 推荐 true，AWS S3 通常为 false）
S3_FORCE_PATH_STYLE=true

# S3 公开访问 URL 前缀（必须设置）
# 相对路径（如 /s3）：用于本地 MinIO，通过 Nginx 转发
# 完整 URL（如 https://cdn.example.com）：用于生产环境 CDN
S3_PUBLIC_BASE=/s3

# ============================================
# 配置说明与最佳实践
# ============================================
# 
# 1. 数据库连接池：
#    - 根据实例数量和数据库最大连接数合理配置
#    - 监控连接池使用率，动态调整参数
#    - 启用健康检查，及时发现连接问题
#
# 2. Rate Limit 配置：
#    - IP限制应大于单用户限制，考虑共享IP场景
#    - 可以通过管理后台实时调整，无需重启服务
#    - 监控触发频率，根据实际情况调整阈值
#
# 3. JWT 配置：
#    - JWT_SECRET 必须使用强随机字符串（32+ 字符）
#    - 生产环境不要使用默认值
#    - Access Token 过期时间不宜过长
#
# 4. S3 配置：
#    - 生产环境必须使用强密码
#    - 建议使用 CDN 加速静态资源访问
#    - S3_PUBLIC_BASE 必须配置为客户端可访问的 URL
#
# 5. 安全建议：
#    - 不要在代码仓库中提交 .env 文件
#    - 定期更换密钥和密码
#    - 使用环境变量管理工具（如 Vault）管理敏感信息
#
# ============================================
