# ============================================================
# HotSpot Frontend 环境变量配置
# ============================================================

# ============ API 配置 ============

NUXT_PUBLIC_API_BASE_URL=http://localhost:8080
NUXT_PUBLIC_WS_BASE_URL=ws://localhost:8080/ws/

# ============ 高德地图配置 ============
# 
# 申请地址：https://console.amap.com/dev/key/app
# 服务平台：选择「Web端(JS API)」
# 
# 安全机制（根据环境自动选择）：
# - 开发环境：使用 securityJsCode 明文方式
# - 生产环境：使用代理服务器转发（需部署 /_AMapService/ 代理）
#
# 参考文档：https://lbs.amap.com/api/javascript-api-v2/guide/abc/jscode

# JS API Key
NUXT_PUBLIC_AMAP_KEY=your-amap-key

# 安全密钥（开发环境使用）
NUXT_PUBLIC_AMAP_SECURITY_CODE=your-security-code

# ============ 其他配置 ============

NUXT_PUBLIC_SITE_URL=https://hotspot.example.com
