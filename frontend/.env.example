# ============================================
# HotSpot Frontend (SvelteKit) Configuration
# ============================================
# 复制此文件为 .env 并修改配置值
# cp .env.example .env
# 测试环境可直接使用 .env.test（已提供默认测试配置模板）

# ============================================
# 高德地图配置（可选，留空时地图功能降级）
# ============================================
# JS API key（前端构建时注入）
VITE_AMAP_KEY=your_amap_key
# 代理服务路径（默认 /_AMapService，与 nginx 代理对应）
VITE_AMAP_SERVICE_HOST=/_AMapService
# 安全密钥 jscode（仅 nginx 代理层使用，不暴露给前端代码）
# 此变量在 compose 环境中传递给 nginx，不会打包进前端产物
# VITE_AMAP_JSCODE=your_amap_jscode

# ============================================
# SvelteKit 服务端配置（生产环境 adapter-node）
# ============================================
# 监听端口（默认 3000）
# PORT=3000

# 监听地址（默认 0.0.0.0）
# HOST=0.0.0.0

# CSRF 保护：允许的 origin（必须与实际访问域名一致）
# 开发环境示例：http://localhost:8888
# 生产环境示例：https://your-domain.com
# ORIGIN=http://localhost:8888

# ============================================
# Mock 模式（仅开发调试用，默认关闭）
# ============================================
# 设为 true 时，前端 dev 模式会拦截 API 请求并返回本地 mock 数据
# 用于后端未启动时调试 UI。生产构建忽略此设置，始终走真实 API。
# USE_MOCK=true
