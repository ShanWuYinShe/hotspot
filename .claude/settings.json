{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "language": "chinese",
  "autoMemoryEnabled": true,
  "respectGitignore": true,
  "permissions": {
    "allow": [
      "WebSearch",
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "TaskCreate",
      "TaskUpdate",
      "TaskList",
      "ExitPlanMode",
      "Bash(git:*)",
      "Bash(pwd)",
      "Bash(ls:*)",
      "Bash(which:*)",
      "Bash(python3 .claude/scripts/status_worktrees.py *)",
      "Bash(python3 .claude/scripts/integrate_prepare.py *)",
      "Bash(python3 .claude/scripts/verify_integrate.py *)",
      "Bash(python3 .claude/scripts/finish_integrate.py *)",
      "Bash(python3 .claude/scripts/sync_back_main.py *)",
      "Bash(python3 .claude/scripts/cleanup_worktrees.py *)",
      "Bash(python3 .claude/scripts/rust_dev.py *)",
      "Bash(python3 .claude/scripts/go_dev.py *)",
      "Bash(python3 .claude/scripts/frontend_dev.py *)",
      "Bash(python3 .claude/scripts/harmony_worktree.py *)",
      "Bash(python3 .claude/scripts/integration_meta.py *)",
      "Bash(python3 .claude/scripts/inspect_verify.py *)",
      "Bash(./deploy/scripts/verify.sh *)",
      "Bash(./deploy/scripts/verify-inspect.sh *)",
      "Bash(./deploy/scripts/preview-build.sh *)",
      "Bash(./deploy/scripts/preview-up.sh *)",
      "Bash(./deploy/scripts/preview-inspect.sh *)",
      "Bash(./deploy/scripts/preview-down.sh *)",
      "Bash(./deploy/scripts/release-build.sh *)",
      "Skill(controlled_tools)",
      "Skill(start_feature)",
      "Skill(start_integrate)",
      "Skill(verify_integrate)",
      "Skill(finish_integrate)",
      "Skill(sync_back_main)",
      "Skill(cleanup_worktrees)",
      "Skill(status_worktrees)",
      "Skill(update-config)",
      "mcp__zai-mcp-server__analyze_image",
      "mcp__web-reader__webReader",
      "WebFetch(domain:docs.anthropic.com)"
    ]
  },
  "hooks": {
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.claude/scripts/worktree_guard.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.claude/scripts/tool_guard.py\""
          }
        ]
      }
    ]
  }
}
