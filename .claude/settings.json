{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "language": "chinese",
  "autoMemoryEnabled": true,
  "respectGitignore": true,
  "permissions": {
    "allow": [
      "WebSearch",
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "TaskCreate",
      "TaskUpdate",
      "TaskList",
      "EnterWorktree",
      "ExitWorktree",
      "Bash(git *)",
      "Bash(python3 .claude/scripts/*)",
      "Bash(*deploy/scripts/*)",
      "Skill(cleanup_worktrees)",
      "Skill(start_feature)",
      "Skill(sync_back_main)",
      "Skill(update-config)",
      "Skill(status_worktrees)",
      "mcp__zai-mcp-server__analyze_image",
      "mcp__web-reader__webReader",
      "WebFetch(domain:docs.anthropic.com)"
    ],
    "ask": [
      "Edit(.claude/settings.json)",
      "Write(.claude/settings.json)",
      "Edit(.claude/settings.local.json)",
      "Write(.claude/settings.local.json)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git merge:*)",
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(*--force*)"
    ]
  },
  "hooks": {
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.claude/scripts/worktree_guard.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.claude/scripts/tool_guard.py\""
          }
        ]
      }
    ]
  }
}
