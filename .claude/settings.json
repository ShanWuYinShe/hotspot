{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "language": "chinese",
  "autoMemoryEnabled": true,
  "respectGitignore": true,
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "TaskCreate",
      "TaskUpdate",
      "TaskList",
      "EnterWorktree",
      "ExitWorktree",
      "Bash(git status:*)",
      "Bash(git rev-parse:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git branch -d:*)",
      "Bash(git branch -D:*)",
      "Bash(git rebase:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git merge --ff-only:*)",
      "Bash(git worktree list:*)",
      "Bash(git worktree add:*)",
      "Bash(git worktree remove:*)",
      "Bash(*deploy/scripts/verify.sh*)",
      "Bash(*deploy/scripts/preview-build.sh*)",
      "Bash(*deploy/scripts/preview-up.sh*)",
      "Bash(*deploy/scripts/preview-down.sh*)",
      "Bash(*deploy/scripts/preview-inspect.sh*)",
      "Bash(*deploy/scripts/release-build.sh*)"
    ],
    "ask": [
      "Edit(.claude/settings.json)",
      "Write(.claude/settings.json)",
      "Edit(.claude/settings.local.json)",
      "Write(.claude/settings.local.json)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git merge:*)",
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(*--force*)"
    ]
  }
}
