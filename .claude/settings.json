{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "language": "chinese",
  "autoMemoryEnabled": true,
  "respectGitignore": true,
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(./deploy/scripts/verify.sh:*)",
      "Bash(./deploy/scripts/verify-inspect.sh:*)",
      "Bash(python3:*)",
      "Bash(git:*)",
      "Bash(cargo:*)",
      "Bash(go:*)",
      "Bash(pnpm:*)",
      "Bash(ohpm:*)",
      "Bash(hvigorw:*)",
      "Bash(./hvigorw:*)"
    ]
  }
}
