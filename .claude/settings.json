{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "language": "chinese",
  "autoMemoryEnabled": true,
  "respectGitignore": true,
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "TaskCreate",
      "TaskUpdate",
      "TaskList",
      "EnterWorktree",
      "ExitWorktree",
      "Bash(git *)",
      "Bash(python3 .claude/scripts/*)",
      "Bash(python3 .claude/scripts/harmony_check.py *)",
      "Bash(./.claude/scripts/harmony_check.py *)",
      "Bash(ohpm *)",
      "Bash(hvigorw *)",
      "Bash(./hvigorw *)",
      "Bash(harmonyapp/hvigorw *)",
      "Bash(./harmonyapp/hvigorw *)",
      "Bash(pnpm *)",
      "Bash(go vet *)",
      "Bash(go fmt *)",
      "Bash(*deploy/scripts/*)"
    ],
    "ask": [
      "Edit(.claude/settings.json)",
      "Write(.claude/settings.json)",
      "Edit(.claude/settings.local.json)",
      "Write(.claude/settings.local.json)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git merge:*)",
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(*--force*)"
    ]
  },
  "hooks": {
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.claude/scripts/worktree_guard.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.claude/scripts/tool_guard.py\""
          }
        ]
      }
    ]
  }
}
