{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "language": "chinese",
  "autoMemoryEnabled": true,
  "respectGitignore": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-edit-guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-edit-format.sh",
            "statusMessage": "Formatting..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(python3:*)",
      "Bash(git:*)",
      "Bash(cargo:*)",
      "Bash(go:*)",
      "Bash(bun:*)",
      "Bash(ohpm:*)",
      "Bash(hvigorw:*)",
      "Bash(./hvigorw:*)",
      "Bash(gofmt:*)",
      "Bash(mkdir:*)",
      "Bash(ls:*)",
      "Bash(chmod:*)",
      "Bash(jq:*)",
      "Bash(basename:*)",
      "Bash(wc:*)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -fd*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(rm -rf /*:*)"
    ]
  }
}
