# ============================================
# HotSpot Frontend (SvelteKit) Configuration
# ============================================
# 复制此文件为 .env 并修改配置值
# cp .env.example .env
# 测试环境可直接使用 .env.test（已提供默认测试配置模板）

# ============================================
# 高德地图配置（可选，地图功能使用）
# ============================================
VITE_AMAP_KEY=your_amap_key
VITE_AMAP_SERVICE_HOST=/_AMapService

# ============================================
# SvelteKit 服务端配置（生产环境 adapter-node）
# ============================================
# 监听端口（默认 3000）
# PORT=3000

# 监听地址（默认 0.0.0.0）
# HOST=0.0.0.0

# CSRF 保护：允许的 origin（必须与实际访问域名一致）
# 开发环境示例：http://localhost:8888
# 生产环境示例：https://your-domain.com
# ORIGIN=http://localhost:8888
