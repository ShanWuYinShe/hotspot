# ── 开发镜像（仅用于 docker-compose.dev.yml）────────────────────────
# 与生产 Dockerfile 的区别：
#   - 保留 Go toolchain（air 热加载需要 go build）
#   - 内置 air（文件监听 + 自动重启），CMD 直接跑 air
#   - 依赖下载用 BuildKit cache mount 缓存，二次构建秒过
#   - postgresql-client 预装：backend-test 启动脚本用 pg_isready/psql
#     做就绪等待与建库（构建期安装，避免运行时出网装包）
# 生产部署请用 Dockerfile（无 toolchain、无 air、USER app）。
ARG GO_VERSION=1.26.10
ARG AIR_VERSION=1.67.4

FROM golang:${GO_VERSION}-alpine

# FROM 之后必须重新声明 ARG 才可在本阶段使用
ARG AIR_VERSION
ARG GOPROXY
# 默认走 goproxy.cn（proxy.golang.org 在国内不可达），compose 亦可显式传参覆盖
ENV GOPROXY=${GOPROXY:-https://goproxy.cn,direct}

RUN --mount=type=cache,target=/go/pkg/mod \
    sed -i 's#dl-cdn.alpinelinux.org#mirrors.aliyun.com#g' /etc/apk/repositories \
    && apk add --no-cache git ca-certificates tzdata curl postgresql-client \
    && go install github.com/air-verse/air@v${AIR_VERSION}

WORKDIR /src

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download

COPY . .

EXPOSE 8081

ENV APP_PORT=8081
ENV APP_HOST=0.0.0.0

CMD ["air"]
