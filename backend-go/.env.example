# ============================================
# HotSpot Backend (Go) — Environment Variables
# ============================================
# 复制此文件为 .env 并填入真实值。
# 生产环境启动时，APP_ENV=production 会拒绝所有已知弱默认值。
# 详见 docs/deployment-guardrails.md

# ============================================
# 应用 (App)
# ============================================
APP_NAME=hotspot-backend-go
APP_ENV=production           # production | staging | dev
LOG_LEVEL=info               # debug | info | warn | error
APP_HOST=0.0.0.0
APP_PORT=8080
TRUSTED_PROXY_CIDRS=

# ============================================
# 数据库 (Postgres / PostGIS)
# ============================================
POSTGRES_DSN=postgresql://user:password@host:5432/hotspot?sslmode=disable

# ============================================
# Redis
# ============================================
REDIS_URL=redis://host:6379/0

# ============================================
# 认证 (Auth)
# ============================================
# 必须 >= 32 字符的强随机字符串。生成方法: openssl rand -hex 32
AUTH_TOKEN_SECRET=change-me
SUPER_ADMIN_PASSWORD=change-me
BCRYPT_COST=12               # 4-31, OWASP 推荐 >= 12

# ============================================
# 对象存储 (S3 / SeaweedFS)
# ============================================
S3_ENDPOINT=http://seaweedfs:8333
S3_PUBLIC_ENDPOINT=https://cdn.example.com
S3_REGION=us-east-1
S3_BUCKET=hotspot
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_FORCE_PATH_STYLE=true

# ============================================
# 可选 (Optional)
# ============================================
PPROF_ADDR=127.0.0.1:6060    # 留空禁用 pprof
APP_SUPPORT_EMAIL=support@example.com
APP_PRIVACY_POLICY_URL=https://example.com/privacy
APP_TERMS_OF_SERVICE_URL=https://example.com/terms
APP_OFFICIAL_WEBSITE_URL=https://example.com
APP_DEFAULT_USER_AVATAR=https://example.com/default-avatar.png
APP_DEFAULT_GROUP_AVATAR=https://example.com/default-group-avatar.png
