# HotSpot Docker 环境变量
# 复制为 .env 后填入真实值: cp .env.example .env

# 数据库
POSTGRES_PASSWORD=postgres

# 应用密钥 — 生产环境 (APP_ENV=production) 必须设为 >=32 字节的高熵随机值,
# 否则后端启动时会拒绝服务 (config.Validate)。生成示例: openssl rand -hex 48
# 开发环境 (APP_ENV=dev) 可留空, 会回退到内置 dev 密钥。
AUTH_TOKEN_SECRET=dev-only-do-not-use-in-production-please-change-to-random-48-bytes

# S3 / SeaweedFS
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me

# Redis (可选 — 缺少时 WebSocket fanout 仅本机内存)
REDIS_URL=

# Nginx 网关：dev 与 prod 共享，反代 /api /ws /s3 到各上游
# docker-compose.yml 与 docker-compose.dev.yml 均通过 ${NGINX_PORT:-8888} 引用
# 访问入口：http://localhost:${NGINX_PORT:-8888}
NGINX_PORT=8888

# 高德地图 (可选 — 缺少时地图相关功能不可用)
VITE_AMAP_KEY=
VITE_AMAP_SECURITY_CODE=
VITE_AMAP_SERVICE_HOST=
