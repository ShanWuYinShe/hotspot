# HotSpot Docker 环境变量
# 复制为 .env 后填入真实值: cp .env.example .env

# 数据库
POSTGRES_PASSWORD=postgres

# 应用密钥 — 必须设置（docker-compose 用 :? 强制，留空则容器拒绝启动）。
# 生产环境 (APP_ENV=production) 必须为 >=32 字节的高熵随机值, 否则后端 config.Validate 拒绝启动。
# 生成示例: openssl rand -hex 48
# 开发环境用下面的默认值即可。
AUTH_TOKEN_SECRET=dev-only-do-not-use-in-production-please-change-to-random-48-bytes

# S3 / SeaweedFS
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me

# Redis（compose 默认注入 redis://redis:6379/0 指向内置 redis；留空即用内置，
# 填外部地址可覆盖——如指向其他实例则 compose 内置 redis 容器仍会启动但不会被使用）
REDIS_URL=

# Nginx 网关：dev 与 prod 共享，反代 /api /ws /s3 到各上游
# docker-compose.yml 与 docker-compose.dev.yml 均通过 ${NGINX_PORT:-8888} 引用
# 访问入口：http://localhost:${NGINX_PORT:-8888}
NGINX_PORT=8888

# 高德地图 (可选 — 缺少时地图相关功能不可用)
VITE_AMAP_KEY=
VITE_AMAP_SECURITY_CODE=
VITE_AMAP_SERVICE_HOST=
