# ============================================
# HotSpot .gitignore
# ============================================

# ============================================
# System Files
# ============================================
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Thumbs.db:encryptable

# ============================================
# Temporary Files
# ============================================
*.tmp
*.log
*.bak
.gocache
.gomodcache
.buncache

# ============================================
# Build Outputs
# ============================================
target/
node_modules/
frontend/build/
frontend/.svelte-kit/
backend-go/server

# ============================================
# IDE & Editor
# ============================================
.vscode/
.idea/
*.swp
*.swo
*~

# ============================================
# Environment Files (do not commit)
# ============================================
.env
.env.local
.env.*.local

# ============================================
# Python (if any)
# ============================================
__pycache__/
*.py[cod]
*$py.class

# ============================================
# AI Tools (local config)
# ============================================
.workwork/
.opencode/
.sisyphus
.worktrees/
.workbuddy-ai/
.claude/settings.local.json
browser-data/
docs/superpowers/
.zcode/
.superpowers
.workbuddy/
.v2c/
backups/

# 构建期生成的前端版本指纹（scripts/write-version-info.mjs）
frontend/static/version.json

# 接待机器人运行时状态（含用户联系记录与当日配额计数，不入库；2026-09-28 迁至顶层 reception-bot/）
reception-bot/state/*.json
reception-bot/state/
.agents/skills/hotspot-reception-bot/state/
