**订阅管理**：

WebSocket订阅机制提供用户状态订阅和群组订阅两种类型：

```typescript
// 订阅项定义（两种类型）
// 单次订阅请求仅允许一个 type，不同 type 需分开请求
interface SubscriptionItemUser {
  type: 'user';
  ids: string[];     // user_id（string）
}
interface SubscriptionItemGroup {
  type: 'group';
  ids: string[];     // group_id（string）
}
type SubscriptionItem = SubscriptionItemUser | SubscriptionItemGroup;

// SetSubscriptions - 替换式订阅（覆盖现有订阅）
// ids 为空表示清空该类型订阅
interface SetSubscriptionsPayloadBase {
  client_msg_id: string;       // 客户端生成，用于与 SubscribeAck 对齐（建议：UUID）
}
interface SetSubscriptionsPayloadUser extends SetSubscriptionsPayloadBase, SubscriptionItemUser {}
interface SetSubscriptionsPayloadGroup extends SetSubscriptionsPayloadBase, SubscriptionItemGroup {}
type SetSubscriptionsPayload = SetSubscriptionsPayloadUser | SetSubscriptionsPayloadGroup;
interface SetSubscriptionsEvent extends WebSocketEvent<"SetSubscriptions", SetSubscriptionsPayload> {}

// 订阅确认事件（服务端回复）

// 订阅失败原因（简化为 3 类）
type SubscriptionFailureReason =
  | 'invalid'   // 订阅项无效（格式错误、目标不存在、超出限制等）
  | 'denied'    // 无权限（无权限订阅、已被拉黑等）
  | 'error';    // 服务端错误（可重试）

interface FailedSubscriptionId {
  subscription_id: string;  // 失败的订阅目标 ID（user 类型为 user_id，group 类型为 group_id）
  reason: SubscriptionFailureReason;
}

interface SubscribeAckPayloadBase {
  client_msg_id: string;                               // 回传客户端消息ID，用于与本次订阅请求一一对应
  operation: SubscriptionOperation;  // 引用 @api_spec_common_types.mdc
  code: number;                                      // 0表示成功，非0表示失败
  message?: string;                                  // 错误消息（失败时）
  failed_ids?: FailedSubscriptionId[];               // 失败的订阅 id（id 类型与 type 对应）
}
interface SubscribeAckPayloadUser extends SubscribeAckPayloadBase, SubscriptionItemUser {}
interface SubscribeAckPayloadGroup extends SubscribeAckPayloadBase, SubscriptionItemGroup {}
type SubscribeAckPayload = SubscribeAckPayloadUser | SubscribeAckPayloadGroup;
interface SubscribeAckEvent extends WebSocketEvent<"SubscribeAck", SubscribeAckPayload> {}
```

