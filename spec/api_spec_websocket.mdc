**私聊消息事件**:

**可见性**：仅会话参与者可见（`@participant-only`）。
```typescript
interface PrivateMessageNewPayload {
  message_id: string;
  target_user_id: string; // 接收者ID (对于发送者多端同步=接收方ID)
  sender: UserInfo;
  type: MessageType;
  content?: string;       // 文本内容
  share_code?: string;    // share 类型消息
  reply_to?: MessageReplyTo;
  // 媒体信息
  media?: MessageMedia;
  sent_at: string;
}
type PrivateMessageNewEvent = { type: "PrivateMessageNew"; payload: PrivateMessageNewPayload; };

interface PrivateMessageEditedPayload {
  message_id: string;
  target_user_id: string;
  content: string;
  edited_at: string;
}
type PrivateMessageEditedEvent = { type: "PrivateMessageEdited"; payload: PrivateMessageEditedPayload; };

interface PrivateMessageRecalledPayload {
  message_id: string;
  target_user_id: string;
  recalled_by: string;    // user_id
  recalled_at: string;
}
type PrivateMessageRecalledEvent = { type: "PrivateMessageRecalled"; payload: PrivateMessageRecalledPayload; };

interface PrivateMessageDeletedPayload {
  message_id: string;
  target_user_id: string;
  deleted_by: string;     // user_id
  deleted_at: string;
}
type PrivateMessageDeletedEvent = { type: "PrivateMessageDeleted"; payload: PrivateMessageDeletedPayload; };

interface PrivateMessageReactionPayload {
  message_id: string;
  target_user_id: string;
  user: UserInfo;                     // 操作者
  reaction_type: ReactionType;
  has_reaction: boolean;              // true=添加, false=移除
  created_at: string;
}
type PrivateMessageReactionEvent = { type: "PrivateMessageReaction"; payload: PrivateMessageReactionPayload; };

interface PrivateMessageReadPayload {
  target_user_id: string;
  up_to: string;        // message_id
  reader_id: string;    // user_id
  read_at: string;
}
type PrivateMessageReadEvent = { type: "PrivateMessageRead"; payload: PrivateMessageReadPayload; };

interface PrivateUserTypingPayload {
  target_user_id: string;
  user_id: string; // 打字的人
  is_typing: boolean;
}
type PrivateUserTypingEvent = { type: "PrivateUserTyping"; payload: PrivateUserTypingPayload; };
```

**群聊消息事件**:

**可见性**：仅群成员可见（`@member-only`）。
```typescript
interface GroupMessageNewPayload {
  message_id: string;
  group_id: string;
  sender: UserInfo;
  type: MessageType;
  content?: string;
  share_code?: string;    // share 类型消息
  reply_to?: MessageReplyTo;
  mentions?: string[];     // user_id
  // 媒体信息
  media?: MessageMedia;
  sent_at: string;
