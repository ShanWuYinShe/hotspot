## 前端集成示例

### 创建位置分享

```typescript
import { createShare } from '@/lib/api/services/share';

async function shareCurrentLocation() {
  const response = await createShare({
    share_type: 'location',
    payload: {
      latitude: 39.9042,
      longitude: 116.4074,
      location_name: '天安门广场'
    }
  });

  if (response.code === 0) {
    const shareUrl = `${window.location.origin}/share/${response.data.share_code}`;
    // 复制链接或分享
    await navigator.clipboard.writeText(shareUrl);
  }
}
```

### 访问分享

```typescript
import { getShare, applyShare } from '@/lib/api/services/share';

async function viewShare(shareCode: string) {
  const response = await getShare({ share_code: shareCode });
  
  if (response.code === 0) {
    const share = response.data;
    
    // 根据类型展示不同UI
    if (share.share_type === 'location') {
      // 显示位置信息
      // 提供"设为浏览锚点"按钮
    }
  }
}

async function applyLocationShare(shareCode: string) {
  const response = await applyShare({ share_code: shareCode });
  
  if (response.code === 0) {
    // 跳转到主页，开始探索
    window.location.href = '/';
  }
}
```

