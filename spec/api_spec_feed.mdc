# HotSpot API 规范 - 信息流与标签 API 模块 v0.0.1 (RPC)

> 本文档定义 HotSpot 信息流 (`feed`) 和标签 (`tags`) 相关的 RPC 接口。

## 服务定义

- **Service Namespaces**:
  - `feed`
  - `tags`
- **Base Paths**:
  - `/api/v1/feed/`
  - `/api/v1/tags/`

## 契约引用

- 公共基础类型：`@api_spec_common.mdc`
- 错误码：`@spec/api_spec_errors.mdc`

---

## 接口概览（按子域）

| 子域 | 端点 | 说明 | Request | Response |
|-----|------|------|---------|----------|
| 信息流 | `POST /api/v1/feed/moments` | 获取瞬间信息流 | `GetFeedMomentsRequest` | `ApiResponse<PaginatedData<FeedMomentItem>>` |
| 信息流 | `POST /api/v1/feed/groups` | 获取群组推荐 | `GetFeedGroupsRequest` | `ApiResponse<PaginatedData<FeedGroupItem>>` |
| 信息流 | `POST /api/v1/feed/users` | 获取用户推荐 | `GetFeedUsersRequest` | `ApiResponse<PaginatedData<FeedUserItem>>` |
| 信息流 | `POST /api/v1/feed/trending` | 获取热门内容 | `GetFeedTrendingRequest` | `ApiResponse<TrendingBundle>` |
| 信息流 | `POST /api/v1/feed/feedback` | 信息流反馈 | `FeedFeedbackRequest` | `ApiResponse` |
| 标签 | `POST /api/v1/tags/trending` | 热门标签 | `TrendingTagsRequest` | `ApiResponse<PaginatedData<TagItem>>` |
| 标签 | `POST /api/v1/tags/suggest` | 标签搜索建议 | `SuggestTagsRequest` | `ApiResponse<PaginatedData<TagSuggestItem>>` |

---

## 核心类型定义

```typescript
// 信息流来源
type FeedSource = 'following' | 'nearby' | 'all';

// 信息流内容类型
type FeedContentType = 'moment' | 'group' | 'user';

// 信息流反馈动作
type FeedFeedbackAction = 'hide' | 'not_interested';

// 标签趋势
type TagTrend = 'rising' | 'stable' | 'falling';

// 标签时间范围
type TagTimeframe = 'daily' | 'weekly' | 'monthly';

// 推荐理由类型（心理学优化：让用户了解为什么推荐）
type RecommendationType = 'friend_liked' | 'nearby' | 'trending' | 'following' | 'tag_match';

interface RecommendationContext {
  type: RecommendationType;
  // 社交证明（仅 friend_liked 类型时存在）
  friends_preview?: UserInfo[];  // 最多2个点赞的好友
}

// FeedMomentItem: 信息流瞬间列表项（组合 MomentBase，带互动状态和推荐理由）
interface FeedMomentItem {
  moment: MomentBase;
  user: UserInfo;
  location: RelativeLocation;
  
  // 互动状态（内联，因为 Feed 端点必然返回互动状态）
  is_liked: boolean;
  is_favorited: boolean;
  
  // 推荐理由（可选，让用户了解为什么看到这条内容）
  recommendation?: RecommendationContext;
}

// FeedGroupItem: 组合 GroupInfo（定义于 @api_spec_common.mdc）
interface FeedGroupItem {
  group: GroupInfo;
  description?: string;
  tags?: string[];
  has_password: boolean;
  location: RelativeLocation;
  friends_in_group?: number;  // 好友中有多少在该群组内
  my_state?: MyGroupState;    // 引用 @api_spec_common.mdc
}

// FeedUserItem: 组合 UserInfo（定义于 @api_spec_common.mdc）
interface FeedUserItem {
  user: UserInfo;
  bio?: string;
  tags?: string[];
  // 隐私受控字段（隐私限制时不返回，不暴露原因）
  presence_status?: UserPresenceStatus;
  last_online?: string;
  location?: RelativeLocation;
  mutual_friends_count?: number;  // 共同好友数
  common_tags?: string[];
  relation?: Relationship;
}

interface TrendingBundle {
  trending_tags: TrendingTagItem[];
  hot_moments: FeedMomentItem[];
}

interface TrendingTagItem {
  name: string;
  usage_count: number;
  trend: TagTrend;
  hot_moment_preview?: FeedMomentItem;
}

interface TagItem {
  name: string;
  usage_count: number;
  trend?: TagTrend;
}

```

## 错误码说明

本模块使用的错误码定义于 `@spec/api_spec_errors.mdc`，主要涉及：

| 错误码 | 说明 | 相关接口 |
|-------|------|---------|
| `10001` | 缺少必填参数 | `feed/moments`、`feed/groups`、`feed/users`、`tags/suggest` |
| `10003` | 参数值超出范围 | 所有带分页参数的接口 |

