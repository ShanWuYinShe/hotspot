## 核心类型定义

```typescript
// 注：GroupInfo、GroupSettings、GroupMemberItem、MyGroupState 等类型定义于 @api_spec_common.mdc

type ApplicationStatus = 'pending' | 'accepted' | 'rejected';

type SetableGroupRole = 'admin' | 'member';  // 可设置的角色（不含 owner）

interface GroupMessageItem {
  message_id: string;
  type: MessageType;
  
  content?: string;
  media?: MessageMedia;
  share_code?: string;
  
  sender: UserInfo;  // 群聊场景：需要完整用户信息
  
  reply_to?: MessageReplyTo;
  mentions?: string[];  // @UserIDs
  recalled_by?: string;
  
  sent_at: string;
  edited_at?: string;
  recalled_at?: string;  // 存在即表示已撤回
  
  read_count?: number;
}

interface GroupSettingsResponse {
  group_id: string;
  settings: GroupSettings;
  has_password: boolean;
  created_at: string;
}

interface GroupOpenResult {
  group: GroupSearchItem;
  recent_messages?: PaginatedData<GroupMessageItem>;
}

interface GroupMemberItem {
  user: UserInfo;
  role: GroupRole;
  joined_at: string;
  muted_until?: string;
  presence_status?: UserPresenceStatus;  // 隐私受控：成员隐私设置时不返回
  last_online?: string;
}

interface Invitation {
  invite_id: string;
  expires_at: string;
}

interface Application {
  application_id: string;
}

// 封禁成员列表项（视角差异）
// - 普通成员视角：仅返回 user、banned_at
// - 管理员视角：返回完整字段
interface BannedMemberItem {
  user: UserInfo;
  banned_at: string;
  reason?: string;
  banned_by?: UserInfo;
}

// 群组申请列表项（视角差异）
// - 申请人视角（查看当前用户的申请）：不返回 handled_by（申请人不应知道是谁处理的）
// - 管理员视角（审核申请列表）：返回完整字段
interface GroupApplicationItem {
  application_id: string;
  applicant: UserInfo;
  message?: string;
  status: ApplicationStatus;
  created_at: string;
  handled_at?: string;
  handled_by?: UserInfo;
}

interface GroupInviteItem {
  invite_id: string;
  group: GroupInfo;
  inviter: UserInfo;
  message?: string;
  status: ApplicationStatus;
  created_at: string;
  expires_at?: string;
}
```

## 错误码说明

本模块使用的错误码定义于 `@spec/api_spec_errors.mdc`，主要涉及：

| 错误码 | 说明 | 相关接口 |
|-------|------|---------|
| `10001` | 缺少必填参数 | 所有带参数的接口 |
| `10003` | 参数值超出范围 | `create`、`update`、公告等 |
| `10200` | 权限不足 | 管理操作（设置角色、禁言、踢人等） |
| `10211` | 已被对方拉黑 | `members/invite` |
| `10212` | 群组密码错误 | `members/join` |
| `10300` | 资源不存在 | 申请/邀请/公告相关 |
| `10320` | 群组不存在 | 所有群组相关接口 |
| `10350` | 消息不存在 | 消息相关接口 |
| `10360` | 文件/媒体不存在 | `create`、`update`、`send` |
| `10402` | 资源状态冲突 | 申请/邀请处理 |
| `10410` | 业务规则冲突 | `members/join`（需申请）、`me/leave`（群主） |
| `10419` | 用户被禁言 | `send` |
| `10414` | 群组已满员 | `members/join`、`members/invite` |
| `10415` | 已在群组中 | `members/join`、`members/invite` |
| `10416` | 不是群组成员 | 大部分群组操作 |
| `10417` | 消息已被撤回 | `update`、`recall` |
| `10418` | 操作时间窗口已过期 | `update`、`recall` |
| `22000` | 幂等键冲突 | `create`、`announcements/create`、`members/join`、`members/apply`、申请/邀请处理、`send` |
| `22002` | 幂等操作正在处理中 | `create`、`announcements/create`、`members/join`、`members/apply`、`send` |

