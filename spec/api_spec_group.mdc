## 类型定义

以下类型定义于 `@api_spec_types.mdc`：
- `GroupInfo`
- `GroupItem`
- `GroupSettings`
- `MyGroupState`
- `GroupAnnouncementItem`
- `GroupRole`
- `GroupJoinMethod`
- `Location`
- `PaginationParams`
- `SearchBaseParams`
- `PaginatedData`
- `ApiResponse`
- `UserInfo`
- `UserPresenceStatus`

以下类型定义于 `@api_spec_chat.mdc`：
- `GroupMessageItem`

```typescript
// 申请状态
type ApplicationStatus = 'pending' | 'accepted' | 'rejected';

// 可设置的角色（不含 owner）
type SetableGroupRole = 'admin' | 'member';

// 群组详情响应
interface GroupOpenResult {
  group: GroupItem;
  recent_messages?: PaginatedData<GroupMessageItem>;  // GroupMessageItem 定义于 @api_spec_chat.mdc
}

// 群组成员列表项
interface GroupMemberItem {
  user: UserInfo;
  role: GroupRole;
  joined_at: string;
  muted_until?: string;           // @group-admin-only（或被禁言者自身可见）
  presence_status?: UserPresenceStatus;  // 隐私受控：成员隐私设置时不返回
  last_online?: string;
}

// 邀请响应
interface Invitation {
  invite_id: string;
  expires_at: string;
}

// 申请响应
interface Application {
  application_id: string;
}

// 群组创建响应：直接返回完整 GroupItem（与 moments/create 返回 MomentItem 保持一致）
// 不再使用独立的 GroupCreated 类型，客户端无需额外请求即可获得完整群组数据

// 封禁成员列表项
interface BannedMemberItem {
  user: UserInfo;
  banned_at: string;
  // === @group-admin-only ===
  reason?: string;
  banned_by?: UserInfo;
}

// 群组申请列表项
interface GroupApplicationItem {
  application_id: string;
  applicant: UserInfo;
  message?: string;
  status: ApplicationStatus;
  created_at: string;
  handled_at?: string;
  // === @group-admin-only ===
  handled_by?: UserInfo;
}

// 群组邀请列表项
interface GroupInviteItem {
  invite_id: string;
  group: GroupInfo;
  inviter: UserInfo;
  message?: string;
  status: ApplicationStatus;
  created_at: string;
  expires_at?: string;
}

// 搜索群组请求
interface SearchGroupsRequest {
  search: SearchBaseParams;
  keyword?: string;    // 关键字搜索（匹配名称、描述等）
  tag?: string;        // 标签筛选
  radius?: number;     // 位置范围（米），配合 search.reference_point 使用
  sort_by?: 'relevance' | 'distance' | 'newest' | 'popular';  // 默认: relevance
