### 3.2 错误处理实现

**错误类型定义** (`src/error.rs`):
```rust
use axum::{
    http::StatusCode,
    response::{IntoResponse, Response},
    Json,
};
use serde_json::json;
use thiserror::Error;

#[derive(Debug, Error)]
pub enum AppError {
    #[error("参数错误: {0}")]
    BadRequest(String),
    
    #[error("认证失败: {0}")]
    Unauthorized(String),
    
    #[error("权限不足")]
    Forbidden,
    
    #[error("资源不存在")]
    NotFound,
    
    #[error("操作冲突: {0}")]
    Conflict(String),
    
    #[error("数据库错误: {0}")]
    Database(#[from] sqlx::Error),
    
    #[error("Redis错误: {0}")]
    Redis(#[from] redis::RedisError),
    
    #[error("JWT错误: {0}")]
    Jwt(#[from] jsonwebtoken::errors::Error),
    
    #[error("密码哈希错误")]
    BcryptError(#[from] bcrypt::BcryptError),
    
    #[error("内部服务器错误")]
    Internal,
}

impl AppError {
    fn error_code(&self) -> i32 {
        match self {
            Self::BadRequest(_) => 1000,
            Self::Unauthorized(_) => 1002,
            Self::Forbidden => 1003,
            Self::NotFound => 1004,
            Self::Conflict(_) => 1005,
            Self::Database(_) => 5001,
            Self::Redis(_) => 5001,
            Self::Jwt(_) => 1002,
            Self::BcryptError(_) => 5000,
            Self::Internal => 5000,
        }
    }
}

impl IntoResponse for AppError {
    fn into_response(self) -> Response {
        let status = StatusCode::OK; // 统一返回 200
        let code = self.error_code();
        let message = self.to_string();
        
        // 记录错误日志
        if code >= 5000 {
            tracing::error!(error = %self, "Internal server error");
        } else {
            tracing::warn!(error = %self, "Client error");
        }
        
        let body = Json(json!({
            "code": code,
            "message": message,
            "data": null,
        }));
        
        (status, body).into_response()
    }
}
```

### 3.3 认证中间件实现

**JWT 认证中间件** (`src/middleware/auth.rs`):
```rust
use axum::{
    extract::{Request, State},
    http::StatusCode,
    middleware::Next,
    response::Response,
};
use crate::{error::AppError, state::AppState, utils::jwt::JwtUtil};

pub struct AuthMiddleware;

impl AuthMiddleware {
    pub async fn check_auth(
        State(state): State<AppState>,
        mut req: Request,
        next: Next,
    ) -> Result<Response, AppError> {
        // 1. 提取 Authorization 头
        let auth_header = req
            .headers()
            .get("Authorization")
            .and_then(|h| h.to_str().ok())
            .ok_or_else(|| AppError::Unauthorized("缺少认证令牌".to_string()))?;
        
        // 2. 验证 Bearer 格式
        let token = auth_header
            .strip_prefix("Bearer ")
            .ok_or_else(|| AppError::Unauthorized("令牌格式错误".to_string()))?;
        
        // 3. 验证 JWT Token
        let claims = JwtUtil::verify_token(token)?;
        let user_id = claims.sub.parse::<i64>()
            .map_err(|_| AppError::Unauthorized("无效的用户ID".to_string()))?;
        
        // 4. 检查 Token 是否在黑名单中（可选）
        let blacklist_key = format!("token_blacklist:{}", token);
        let is_blacklisted: bool = redis::cmd("EXISTS")
            .arg(&blacklist_key)
            .query_async(&mut state.redis.clone())
            .await
            .unwrap_or(false);
        
        if is_blacklisted {
            return Err(AppError::Unauthorized("令牌已失效".to_string()));
        }
        
        // 5. 将 user_id 注入到请求扩展中
        req.extensions_mut().insert(user_id);
        
        // 6. 继续处理请求
        Ok(next.run(req).await)
    }
}

/// 从请求中提取当前用户ID
pub fn extract_user_id(req: &Request) -> Result<i64, AppError> {
    req.extensions()
        .get::<i64>()
        .copied()
        .ok_or_else(|| AppError::Unauthorized("未认证".to_string()))
}
```

### 3.4 参数验证实现

**验证工具** (`src/utils/validation.rs`):
```rust
use crate::error::AppError;

pub struct Validator;

impl Validator {
    /// 验证经纬度
    pub fn validate_coordinates(latitude: f64, longitude: f64) -> Result<(), AppError> {
        if latitude < -90.0 || latitude > 90.0 {
            return Err(AppError::BadRequest("纬度必须在 -90 到 90 之间".to_string()));
        }
        if longitude < -180.0 || longitude > 180.0 {
            return Err(AppError::BadRequest("经度必须在 -180 到 180 之间".to_string()));
        }
        Ok(())
    }
    
    /// 验证分页参数
    pub fn validate_pagination(limit: Option<i32>, max_limit: i32) -> Result<i32, AppError> {
        let limit = limit.unwrap_or(20);
        if limit < 1 || limit > max_limit {
            return Err(AppError::BadRequest(
                format!("limit 必须在 1 到 {} 之间", max_limit)
            ));
        }
        Ok(limit)
    }
    
    /// 验证搜索半径
    pub fn validate_radius(radius: Option<i32>, max_radius: i32) -> Result<i32, AppError> {
        let radius = radius.unwrap_or(5000);
        if radius < 1 || radius > max_radius {
            return Err(AppError::BadRequest(
                format!("radius 必须在 1 到 {} 之间", max_radius)
            ));
        }
        Ok(radius)
    }
}
