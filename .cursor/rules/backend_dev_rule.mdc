### 5.1 密码安全实现

**密码工具** (`src/utils/password.rs`):
```rust
use bcrypt::{hash, verify, DEFAULT_COST};
use crate::error::AppError;

pub struct PasswordUtil;

impl PasswordUtil {
    /// 对客户端哈希进行 bcrypt 二次哈希
    /// client_hash: SHA256(password) from client
    pub fn hash_password(client_hash: &str) -> Result<String, AppError> {
        // 验证客户端哈希格式（应为64字符的十六进制）
        if client_hash.len() != 64 {
            return Err(AppError::BadRequest("密码哈希格式错误".to_string()));
        }
        
        // 使用 bcrypt 进行二次哈希，work factor = 12
        let hashed = hash(client_hash, 12)?;
        Ok(hashed)
    }
    
    /// 验证密码
    /// client_hash: SHA256(password) from client
    /// stored_hash: bcrypt hash from database
    pub fn verify_password(client_hash: &str, stored_hash: &str) -> Result<bool, AppError> {
        let is_valid = verify(client_hash, stored_hash)?;
        Ok(is_valid)
    }
}
```

### 5.2 JWT Token 实现

**JWT 工具** (`src/utils/jwt.rs`):
```rust
use chrono::{Duration, Utc};
use jsonwebtoken::{decode, encode, DecodingKey, EncodingKey, Header, Validation};
use serde::{Deserialize, Serialize};
use crate::error::AppError;

#[derive(Debug, Serialize, Deserialize)]
pub struct Claims {
    pub sub: String,        // user_id
    pub exp: i64,           // expiration time
    pub iat: i64,           // issued at
    pub user_type: u8,      // user type
}

pub struct JwtUtil;

impl JwtUtil {
    fn get_secret() -> String {
        std::env::var("JWT_SECRET").expect("JWT_SECRET must be set")
    }
    
    /// 生成 JWT Token
    pub fn generate_token(user_id: i64, expires_in_seconds: i64) -> Result<String, AppError> {
        let now = Utc::now();
        let exp = now + Duration::seconds(expires_in_seconds);
        
        // 提取用户类型（高8位）
        let user_type = ((user_id >> 56) & 0xFF) as u8;
        
        let claims = Claims {
            sub: user_id.to_string(),
            exp: exp.timestamp(),
            iat: now.timestamp(),
            user_type,
        };
        
        let token = encode(
            &Header::default(),
            &claims,
            &EncodingKey::from_secret(Self::get_secret().as_bytes()),
        )?;
        
        Ok(token)
    }
    
    /// 验证 JWT Token
    pub fn verify_token(token: &str) -> Result<Claims, AppError> {
        let token_data = decode::<Claims>(
            token,
            &DecodingKey::from_secret(Self::get_secret().as_bytes()),
            &Validation::default(),
        )?;
        
        Ok(token_data.claims)
    }
}
```

### 5.3 用户ID生成

**ID 生成器** (`src/utils/id_gen.rs`):
```rust
use std::sync::atomic::{AtomicU64, Ordering};

static SEQUENCE: AtomicU64 = AtomicU64::new(1);

pub struct IdGenerator;

impl IdGenerator {
    /// 生成用户ID
    /// user_type: 0x01 (临时), 0x02 (普通), 0x03 (系统)
    pub fn generate_user_id(user_type: u8) -> i64 {
        let sequence = SEQUENCE.fetch_add(1, Ordering::SeqCst);
        let type_bits = (user_type as i64) << 56;
        let sequence_bits = sequence & 0x00FFFFFFFFFFFFFF;
        type_bits | sequence_bits
    }
    
    /// 提取用户类型
    pub fn extract_user_type(user_id: i64) -> u8 {
        ((user_id >> 56) & 0xFF) as u8
    }
    
    /// 判断是否为临时用户
    pub fn is_temp_user(user_id: i64) -> bool {
        Self::extract_user_type(user_id) == 0x01
    }
}
```

### 5.4 地理位置计算

**地理位置工具** (`src/utils/geo.rs`):
```rust
use crate::error::AppError;

pub struct GeoUtil;

impl GeoUtil {
    /// 计算两点之间的距离（米）
    /// 使用 Haversine 公式
    pub fn calculate_distance(
        lat1: f64,
        lon1: f64,
        lat2: f64,
        lon2: f64,
    ) -> f64 {
        const EARTH_RADIUS: f64 = 6371000.0; // 地球半径（米）
        
        let lat1_rad = lat1.to_radians();
        let lat2_rad = lat2.to_radians();
        let delta_lat = (lat2 - lat1).to_radians();
        let delta_lon = (lon2 - lon1).to_radians();
        
        let a = (delta_lat / 2.0).sin().powi(2)
            + lat1_rad.cos() * lat2_rad.cos() * (delta_lon / 2.0).sin().powi(2);
        
        let c = 2.0 * a.sqrt().atan2((1.0 - a).sqrt());
        
        EARTH_RADIUS * c
    }
    
    /// 验证坐标合法性
    pub fn validate_coordinates(latitude: f64, longitude: f64) -> Result<(), AppError> {
        if latitude < -90.0 || latitude > 90.0 {
            return Err(AppError::BadRequest("纬度必须在 -90 到 90 之间".to_string()));
        }
        if longitude < -180.0 || longitude > 180.0 {
            return Err(AppError::BadRequest("经度必须在 -180 到 180 之间".to_string()));
        }
        Ok(())
    }
}
```

### 5.5 搜索接口统一实现

**搜索服务示例** (`src/services/search_service.rs`):
```rust
use sqlx::PgPool;
use crate::{
    dto::response::PaginatedResponse,
    error::AppError,
    models::user::User,
    repositories::user_repo::UserRepository,
    utils::geo::GeoUtil,
};

pub struct SearchService {
    user_repo: UserRepository,
}

impl SearchService {
    pub fn new(db: &PgPool) -> Self {
        Self {
            user_repo: UserRepository::new(db.clone()),
        }
    }
    
    /// 按位置搜索用户（统一模式）
    pub async fn search_users_by_location(
        &self,
        latitude: f64,
        longitude: f64,
        radius: Option<i32>,
        limit: Option<i32>,
        cursor: Option<String>,
    ) -> Result<PaginatedResponse<User>, AppError> {
        // 1. 验证坐标
        GeoUtil::validate_coordinates(latitude, longitude)?;
        
        // 2. 验证半径（默认5000，最大50000）
        let radius = radius.unwrap_or(5000).min(50000).max(1);
        
        // 3. 验证分页参数（默认20，最大100）
        let limit = limit.unwrap_or(20).min(100).max(1);
        
        // 4. 调用 Repository
        let (users, next_cursor) = self.user_repo
            .search_by_location(latitude, longitude, radius, limit, cursor)
            .await?;
        
        // 5. 构造分页响应
        Ok(PaginatedResponse {
            items: users,
            has_more: next_cursor.is_some(),
            next_cursor,
        })
    }
    
    /// 按名称搜索用户（统一模式）
    pub async fn search_users_by_name(
        &self,
        name: &str,
        limit: Option<i32>,
        cursor: Option<String>,
    ) -> Result<PaginatedResponse<User>, AppError> {
        // 验证参数
        if name.is_empty() {
            return Err(AppError::BadRequest("搜索关键词不能为空".to_string()));
        }
        
        let limit = limit.unwrap_or(20).min(100).max(1);
        
        // 调用 Repository
        let (users, next_cursor) = self.user_repo
            .search_by_name(name, limit, cursor)
            .await?;
        
        Ok(PaginatedResponse {
            items: users,
            has_more: next_cursor.is_some(),
            next_cursor,
        })
    }
    
    /// 按ID搜索用户（统一模式）
    pub async fn search_user_by_id(&self, user_id: i64) -> Result<User, AppError> {
        self.user_repo
            .find_by_id(user_id)
            .await?
            .ok_or(AppError::NotFound)
    }
}
