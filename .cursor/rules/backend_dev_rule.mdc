use futures_util::stream::SplitSink;
use tokio::net::TcpStream;
use tokio_tungstenite::WebSocketStream;

type WsSender = SplitSink<WebSocketStream<TcpStream>, Message>;

pub struct ConnectionManager {
    // user_id -> Vec<connection>
    connections: Arc<RwLock<HashMap<i64, Vec<WsSender>>>>,
}

impl ConnectionManager {
    pub fn new() -> Self {
        Self {
            connections: Arc::new(RwLock::new(HashMap::new())),
        }
    }
    
    /// 添加连接
    pub async fn add_connection(&self, user_id: i64, sender: WsSender) {
        let mut connections = self.connections.write().await;
        connections.entry(user_id).or_insert_with(Vec::new).push(sender);
        tracing::info!(user_id = %user_id, "WebSocket connection added");
    }
    
    /// 移除连接
    pub async fn remove_connection(&self, user_id: i64) {
        let mut connections = self.connections.write().await;
        connections.remove(&user_id);
        tracing::info!(user_id = %user_id, "WebSocket connection removed");
    }
    
    /// 发送消息给指定用户
    pub async fn send_to_user(&self, user_id: i64, message: Message) -> Result<(), ()> {
        let connections = self.connections.read().await;
        if let Some(senders) = connections.get(&user_id) {
            for sender in senders {
                // 发送消息（实际实现需要处理 sender 的可变性）
                // sender.send(message.clone()).await?;
            }
        }
        Ok(())
    }
    
    /// 广播消息给多个用户
    pub async fn broadcast(&self, user_ids: Vec<i64>, message: Message) {
        for user_id in user_ids {
