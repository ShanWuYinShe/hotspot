### 9.3 事务处理

```rust
use sqlx::Transaction;

pub async fn transfer_ownership(
    &self,
    group_id: Uuid,
    old_owner_id: i64,
    new_owner_id: i64,
) -> Result<(), AppError> {
    let mut tx = self.pool.begin().await?;
    
    // 1. 更新群组所有者
    sqlx::query!(
        "UPDATE groups SET owner_id = $1 WHERE group_id = $2",
        new_owner_id,
        group_id
    )
    .execute(&mut *tx)
    .await?;
    
    // 2. 更新旧所有者角色为管理员
    sqlx::query!(
        "UPDATE group_members SET role = 'admin' WHERE group_id = $1 AND user_id = $2",
        group_id,
        old_owner_id
    )
    .execute(&mut *tx)
    .await?;
    
    // 3. 更新新所有者角色为群主
    sqlx::query!(
        "UPDATE group_members SET role = 'owner' WHERE group_id = $1 AND user_id = $2",
        group_id,
        new_owner_id
    )
    .execute(&mut *tx)
    .await?;
    
    tx.commit().await?;
    Ok(())
}
```

