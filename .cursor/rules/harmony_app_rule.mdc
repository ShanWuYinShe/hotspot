// 显示用户类型标识
UserTypeIndicator({ userType: userProfile.user_type })
```

## 5. WebSocket通信规范

**WebSocket设计理念**（完全遵循 `@api_spec.mdc` 第4章"WebSocket 实时事件定义"）：
- **核心定位**：WebSocket 是实时数据推送通道，用于服务端主动向客户端推送所有需要实时处理的数据
- **API + WebSocket 双通道架构**：API负责历史查询，WebSocket负责实时推送
- **协作流程**：启动时 API 加载历史 → WebSocket 接收实时推送；重连后 API 补拉离线数据

### 5.1 连接与鉴权

**连接端点**：`wss://[server]/ws/`

**鉴权机制**：
- 采用受保护的 HTTP 登录后，下发 `access_token`
- WebSocket 连接时通过以下方式之一传递token：
  - `Sec-WebSocket-Protocol` 子协议头
  - `Authorization: Bearer <token>` 头
- Token过期时服务端会主动断开连接，客户端需要刷新token后重连

### 5.2 心跳机制

**心跳参数**：
- 客户端每 25秒 发送 `Ping` 事件
- 服务端在 5秒 内必须回复 `Pong` 事件
- 如果3次心跳失败，客户端主动断开并重连
- 服务端如果60秒未收到任何消息，主动断开连接

**心跳实现**：
```typescript
class HeartbeatManager {
  private heartbeatTimer: number | null = null;
  private heartbeatInterval: number = 25000; // 25秒
  private missedHeartbeats: number = 0;
  private maxMissedHeartbeats: number = 3;
  
  start(wsService: WebSocketService) {
    this.stop(); // 清除旧的定时器
    
    this.heartbeatTimer = setInterval(() => {
      // 发送 Ping
      wsService.send({
        type: 'Ping',
        payload: {
          timestamp: new Date().toISOString()
        }
      });
      
      // 增加未收到回复计数
      this.missedHeartbeats++;
      
      // 检查是否超过最大失败次数
      if (this.missedHeartbeats >= this.maxMissedHeartbeats) {
        console.error('心跳失败次数过多，断开连接');
        wsService.disconnect();
        this.stop();
      }
    }, this.heartbeatInterval);
  }
  
  // 收到 Pong 时重置计数
  onPong() {
    this.missedHeartbeats = 0;
  }
  
  stop() {
    if (this.heartbeatTimer) {
      clearInterval(this.heartbeatTimer);
      this.heartbeatTimer = null;
    }
    this.missedHeartbeats = 0;
  }
}
```

### 5.3 重连策略（指数退避算法）

**重连参数**：
```typescript
const reconnectConfig = {
  baseDelay: 1000,      // 基础延迟 1秒
  maxDelay: 30000,      // 最大延迟 30秒
  maxAttempts: 10,      // 最大重连次数
  jitterFactor: 0.2     // 随机抖动因子 20%
};
```

**重连实现**：
```typescript
class ReconnectManager {
  private reconnectAttempts: number = 0;
  private reconnectTimer: number | null = null;
  
  calculateDelay(attempt: number): number {
    // 指数退避：delay = min(baseDelay * 2^attempt, maxDelay)
    const exponentialDelay = Math.min(
      reconnectConfig.baseDelay * Math.pow(2, attempt),
      reconnectConfig.maxDelay
    );
    
    // 添加随机抖动：±20%
    const jitter = exponentialDelay * reconnectConfig.jitterFactor * (Math.random() * 2 - 1);
    return Math.max(0, Math.floor(exponentialDelay + jitter));
  }
  
  scheduleReconnect(connectFn: () => void) {
    if (this.reconnectAttempts >= reconnectConfig.maxAttempts) {
      console.error('超过最大重连次数，停止重连');
      return;
    }
    
    const delay = this.calculateDelay(this.reconnectAttempts);
    console.info(`第 ${this.reconnectAttempts + 1} 次重连，延迟 ${delay}ms`);
    
    this.reconnectTimer = setTimeout(() => {
      this.reconnectAttempts++;
      connectFn();
    }, delay);
  }
  
  reset() {
    this.reconnectAttempts = 0;
    if (this.reconnectTimer) {
      clearTimeout(this.reconnectTimer);
      this.reconnectTimer = null;
    }
  }
  
  cancel() {
    if (this.reconnectTimer) {
      clearTimeout(this.reconnectTimer);
      this.reconnectTimer = null;
    }
  }
}
```

### 5.4 订阅管理

**订阅机制**（完整规范见 `@api_spec.mdc` 第4.4节）：
```typescript
class SubscriptionManager {
  private subscribedRooms: Set<string> = new Set();
  private subscribedUsers: Set<string> = new Set();
  private subscribedNotifications: Set<string> = new Set();
  
  // 1. Subscribe - 增量订阅（追加到现有订阅）
  subscribeRooms(wsService: WebSocketService, roomIds: string[]) {
    roomIds.forEach(id => this.subscribedRooms.add(id));
    wsService.send({
      type: 'Subscribe',
      payload: {
        rooms: roomIds
      }
    });
  }
  
  // 订阅用户
  subscribeUsers(wsService: WebSocketService, userIds: string[]) {
    userIds.forEach(id => this.subscribedUsers.add(id));
    wsService.send({
      type: 'Subscribe',
      payload: {
        users: userIds
      }
    });
  }
  
  // 订阅通知类型
  subscribeNotifications(wsService: WebSocketService, types: string[]) {
    types.forEach(type => this.subscribedNotifications.add(type));
    wsService.send({
      type: 'Subscribe',
      payload: {
        notifications: types
      }
    });
  }
  
  // 2. Unsubscribe - 取消订阅（从现有订阅中移除）
  unsubscribeRooms(wsService: WebSocketService, roomIds: string[]) {
    roomIds.forEach(id => this.subscribedRooms.delete(id));
    wsService.send({
      type: 'Unsubscribe',
      payload: {
        rooms: roomIds
      }
    });
  }
  
  // 3. SetSubscriptions - 替换式订阅（覆盖现有订阅）
  setAllSubscriptions(wsService: WebSocketService) {
    wsService.send({
      type: 'SetSubscriptions',
      payload: {
        rooms: this.subscribedRooms.size > 0 ? Array.from(this.subscribedRooms) : [],
        users: this.subscribedUsers.size > 0 ? Array.from(this.subscribedUsers) : [],
        notifications: this.subscribedNotifications.size > 0 ? Array.from(this.subscribedNotifications) : []
      }
    });
  }
  
  // 重新订阅所有（重连后使用 SetSubscriptions）
  resubscribeAll(wsService: WebSocketService) {
    this.setAllSubscriptions(wsService);
  }
}
```

### 5.5 完整的WebSocket服务实现

**WebSocket服务类**：
```typescript
import webSocket from '@ohos.net.webSocket';

class WebSocketService {
  private ws: webSocket.WebSocket | null = null;
  private url: string = '';
  private token: string = '';
  
  private heartbeatManager: HeartbeatManager = new HeartbeatManager();
  private reconnectManager: ReconnectManager = new ReconnectManager();
  private subscriptionManager: SubscriptionManager = new SubscriptionManager();
  
  private messageHandlers: Map<string, (data: any) => void> = new Map();
  private isConnecting: boolean = false;
  
  async connect(url: string, token: string): Promise<void> {
    if (this.isConnecting) {
      console.warn('WebSocket正在连接中...');
      return;
    }
    
    this.url = url;
    this.token = token;
    this.isConnecting = true;
    
    return new Promise((resolve, reject) => {
      this.ws = webSocket.createWebSocket();
      
      this.ws.on('open', () => {
        console.info('WebSocket连接已建立');
        this.isConnecting = false;
        
        // 认证
        this.send({
          type: 'Auth',
          payload: { token: this.token }
        });
        
        // 启动心跳
        this.heartbeatManager.start(this);
        
        // 重置重连计数
        this.reconnectManager.reset();
        
        // 重新订阅
        this.subscriptionManager.resubscribeAll(this);
        
        resolve();
      });
      
      this.ws.on('message', (err, value) => {
        if (!err && typeof value === 'string') {
          this.handleMessage(value);
        }
      });
      
      this.ws.on('close', () => {
        console.info('WebSocket连接已关闭');
        this.isConnecting = false;
        this.heartbeatManager.stop();
        
        // 尝试重连
        this.reconnectManager.scheduleReconnect(() => {
          this.connect(this.url, this.token);
        });
      });
      
      this.ws.on('error', (err) => {
        console.error('WebSocket错误:', err);
        this.isConnecting = false;
        reject(err);
      });
      
      // 连接到服务器
      this.ws.connect(url);
    });
  }
  
  private handleMessage(message: string) {
    try {
      const wsEvent = JSON.parse(message);
      const { type, payload } = wsEvent;
      
      // 处理 Pong 消息
      if (type === 'Pong') {
        this.heartbeatManager.onPong();
        return;
      }
      
      // 调用注册的处理器
      const handler = this.messageHandlers.get(type);
      if (handler) {
        handler(payload);
      } else {
        console.warn(`未处理的WebSocket消息类型: ${type}`);
      }
    } catch (error) {
      console.error('WebSocket消息解析失败:', error);
    }
  }
  
  // 注册消息处理器
  onMessage(type: string, handler: (data: any) => void) {
    this.messageHandlers.set(type, handler);
  }
  
  // 发送消息
  send(message: any) {
    if (this.ws) {
      this.ws.send(JSON.stringify(message));
    } else {
      console.error('WebSocket未连接');
    }
  }
  
  // 断开连接
  disconnect() {
    this.reconnectManager.cancel();
    this.heartbeatManager.stop();
    
    if (this.ws) {
      this.ws.close();
      this.ws = null;
    }
  }
  
  // 订阅方法
  subscribeRooms(roomIds: string[]) {
    this.subscriptionManager.subscribeRooms(this, roomIds);
  }
  
  subscribeUsers(userIds: string[]) {
    this.subscriptionManager.subscribeUsers(this, userIds);
  }
  
  subscribeNotifications(types: string[]) {
    this.subscriptionManager.subscribeNotifications(this, types);
  }
}
```

