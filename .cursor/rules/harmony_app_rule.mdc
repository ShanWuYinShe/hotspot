        break;
      
      // 速率限制
      case 1400: // 请求过于频繁
      case 1401:
      case 1402:
      case 1403:
      case 1404:
        this.showError('操作过于频繁，请稍后再试');
        break;
      
      // 服务器错误
      case 5000:
      case 5001:
      case 5002:
        this.showError('服务器繁忙，请稍后再试');
