**错误恢复机制**：
```typescript
// 批量操作失败后重试失败项
async function batchOperationWithRetry<T>(
  items: T[],
  batchApi: (items: T[]) => Promise<BatchResponse<any>>,
  maxRetries: number = 2
): Promise<{ total: number; succeeded: number; failed: number }> {
  let remainingItems = [...items];
  let attempt = 0;
  
  while (attempt < maxRetries && remainingItems.length > 0) {
    const result = await batchApi(remainingItems);
    
    if (result.failed === 0) {
      return {
        total: items.length,
        succeeded: items.length,
        failed: 0
      };
    }
    
    // 提取失败的项
    const failedIndices = result.results
      .filter(r => r.code !== 0)
      .map(r => r.index);
    
    remainingItems = failedIndices.map(i => remainingItems[i]);
    attempt++;
    
    if (attempt < maxRetries) {
      await new Promise(resolve => setTimeout(resolve, 1000 * attempt));  // 指数退避
    }
  }
  
  return {
    total: items.length,
    succeeded: items.length - remainingItems.length,
    failed: remainingItems.length
  };
}
```

