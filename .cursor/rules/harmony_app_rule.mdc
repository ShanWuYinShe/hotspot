**部分失败处理**：
```typescript
function handleBatchResult<T>(
  result: BatchResponse<T>, 
  itemNames: string[]
): { type: 'success' | 'warning' | 'error'; message: string; details?: string } {
  if (result.failed === 0) {
    // 全部成功
    return {
      type: 'success',
      message: `成功处理 ${result.succeeded} 项`
    };
  } else if (result.succeeded === 0) {
    // 全部失败
    return {
      type: 'error',
      message: `批量操作失败，所有 ${result.total} 项均未成功`
    };
  } else {
    // 部分成功
    const failedItems = result.results
      .filter(r => r.code !== 0)
      .map(r => itemNames[r.index]);
    
    return {
      type: 'warning',
      message: `${result.succeeded} 项成功，${result.failed} 项失败`,
      details: failedItems.join(', ')
    };
  }
}
```

### 13.3 批量操作最佳实践

**分批处理大量数据**：
```typescript
// 处理超过100条的大量数据
async function processManyItems<T>(
  items: T[],
  batchApi: (batch: T[]) => Promise<BatchResponse<any>>
): Promise<{ total: number; succeeded: number; failed: number }> {
  const BATCH_SIZE = 100;
  const batches: T[][] = [];
  
  for (let i = 0; i < items.length; i += BATCH_SIZE) {
    const batch = items.slice(i, i + BATCH_SIZE);
    batches.push(batch);
  }
  
  const results = {
    total: items.length,
    succeeded: 0,
    failed: 0
  };
  
  for (const batch of batches) {
    const result = await batchApi(batch);
    results.succeeded += result.succeeded;
    results.failed += result.failed;
  }
  
  return results;
}
```

