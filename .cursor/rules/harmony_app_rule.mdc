        .backgroundColor($r('sys.color.ohos_id_color_emphasize_bg'))
        .padding({ left: 6, right: 6, top: 2, bottom: 2 })
        .borderRadius(4)
    }
    // 普通用户不显示标识
  }
}
```

**使用示例**：
```typescript
