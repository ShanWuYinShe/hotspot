### 2.3 群组管理 API

#### 通用群组信息响应类型

**GroupResponse** - 群组基本信息（用于搜索、列表等）
```typescript
{
  id: string;               // UUID转字符串
  type: 'public_group' | 'private_group';
  name: string;             // 群组名称
  description?: string;     // 群组描述
  avatar_url?: string;      // 群组头像URL
  owner_id: string;         // 群主ID
  owner_name: string;       // 群主昵称
  location_name: string;    // 位置名称
  member_count: number;     // 成员数量
  is_password_required: boolean;
  created_at: string;       // 创建时间
  is_member: boolean;       // 当前用户是否为成员
}
```

**GroupDetailResponse** - 群组详细信息（用于查看群组详情）
```typescript
{
  id: string;
  type: 'public_group' | 'private_group';
  name: string;
  description?: string;
  avatar_url?: string;
  owner_id: string;
  owner_name: string;
  latitude: number;         // 纬度
  longitude: number;        // 经度
  location_name: string;
  member_count: number;
  max_members?: number;     // 最大成员数
  is_password_required: boolean;
  created_at: string;
  last_active_at: string;
  
  // 当前用户与群组的关系（仅在已登录时返回）
  my_role?: 'owner' | 'admin' | 'member';  // 我的角色（非成员时不返回）
  is_member: boolean;
}
```

**MyGroupResponse** - 我的群组信息（用于"我的群组列表"）
```typescript
{
  id: string;
  type: 'public_group' | 'private_group';
  name: string;
  description?: string;
  avatar_url?: string;
  owner_id: string;
  latitude: number;         // 纬度（用于地图显示）
  longitude: number;        // 经度（用于地图显示）
  location_name: string;
  member_count: number;
  my_role: 'owner' | 'admin' | 'member';
  unread_count: number;
  notifications_enabled: boolean;
  mention_only: boolean;
  joined_at: string;
  last_active_at: string;
  last_message?: {
    content: string;
    sender_name: string;
    sent_at: string;
  };
}
```

说明：
- `GroupResponse` 用于搜索、浏览群组列表等场景
- `GroupDetailResponse` 用于查看群组详情页
- `MyGroupResponse` 用于"我的群组列表"，包含未读数、通知设置等个人相关信息

