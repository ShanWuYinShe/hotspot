### 4.3 数据库性能设计

#### 4.3.1 消息系统大表性能设计

**核心挑战**：
- 消息表随时间增长可达千万甚至亿级记录
- 并发查询导致锁竞争和性能下降
- 需要平衡查询性能、存储成本和维护复杂度

**方案1：分区表设计**

```sql
-- 按时间分区的messages表
CREATE TABLE messages (
    id BIGSERIAL,
    message_id TEXT UNIQUE NOT NULL DEFAULT generate_unique_id(),
    group_id BIGINT NOT NULL REFERENCES groups(id) ON DELETE CASCADE,
    sender_id BIGINT REFERENCES users(id),
    content TEXT NOT NULL,
    message_type message_type_enum NOT NULL DEFAULT 'text',
    created_at TIMESTAMP WITH TIME ZONE NOT NULL DEFAULT NOW(),
    -- ... 其他字段
) PARTITION BY RANGE (created_at);

-- 创建月度分区（自动化脚本管理）
CREATE TABLE messages_2024_01 PARTITION OF messages
    FOR VALUES FROM ('2024-01-01') TO ('2024-02-01');
CREATE TABLE messages_2024_02 PARTITION OF messages
    FOR VALUES FROM ('2024-02-01') TO ('2024-03-01');
-- ... 继续创建分区

-- 每个分区的索引
CREATE INDEX idx_messages_2024_01_group_created ON messages_2024_01 (group_id, created_at DESC);
CREATE INDEX idx_messages_2024_01_sender ON messages_2024_01 (sender_id);
```

**分区优势**：
- 查询只扫描相关分区，提高查询效率
- 老分区可以独立维护、备份、删除
- 并发写入分散到不同分区，减少锁竞争
- 分区修剪（Partition Pruning）自动选择相关分区

**方案2：读写分离 + 缓存策略**

```sql
-- 热数据表（最近30天消息）
CREATE TABLE messages_hot (
    id BIGSERIAL PRIMARY KEY,
    message_id TEXT UNIQUE NOT NULL,
    group_id BIGINT NOT NULL,
    sender_id BIGINT,
    content TEXT NOT NULL,
    created_at TIMESTAMP WITH TIME ZONE NOT NULL DEFAULT NOW(),
    -- ... 其他字段
    
    -- 高性能索引
    INDEX idx_hot_group_created (group_id, created_at DESC),
    INDEX idx_hot_sender (sender_id),
    INDEX idx_hot_message_id (message_id)
);

-- 冷数据表（30天前消息）
CREATE TABLE messages_cold (
    -- 相同结构
    -- 压缩存储，查询频率低
) WITH (fillfactor = 100); -- 高填充因子，减少存储空间
```

**数据迁移策略**：
```sql
-- 定时任务：每日将30天前的热数据迁移到冷数据表
INSERT INTO messages_cold 
SELECT * FROM messages_hot 
WHERE created_at < NOW() - INTERVAL '30 days';

DELETE FROM messages_hot 
WHERE created_at < NOW() - INTERVAL '30 days';
```

**方案3：高性能索引策略**

```sql
-- messages表核心索引设计
CREATE INDEX CONCURRENTLY idx_messages_group_time_covering 
ON messages (group_id, created_at DESC) 
INCLUDE (id, sender_id, content, message_type); -- 覆盖索引

CREATE INDEX CONCURRENTLY idx_messages_sender_time 
ON messages (sender_id, created_at DESC) 
WHERE sender_id IS NOT NULL; -- 部分索引

CREATE INDEX CONCURRENTLY idx_messages_group_unread 
ON messages (group_id, id DESC) 
WHERE is_deleted = false; -- 条件索引
```

**索引优势**：
- 覆盖索引避免回表查询
- 部分索引减少索引大小
- 条件索引只索引有效数据

#### 4.3.2 并发控制和锁设计

**读写分离架构**：
```sql
-- 使用PostgreSQL流复制
-- 主库：处理写操作（发送消息、更新状态）
-- 从库：处理读操作（查询消息历史、会话列表）

-- 应用层路由策略
-- 写操作 -> 主库
-- 读操作 -> 从库（可配置多个从库负载均衡）
```

**连接池配置**：
```rust
// 数据库连接池配置
sqlx::postgres::PgPoolOptions::new()
    .max_connections(50)           // 最大连接数
    .min_connections(10)           // 最小连接数
    .acquire_timeout(Duration::from_secs(30))
    .idle_timeout(Duration::from_secs(600))
    .max_lifetime(Duration::from_secs(1800))
```

**高并发查询策略**：

```sql
-- 1. 使用游标分页避免OFFSET性能问题
SELECT id, message_id, sender_id, content, created_at
FROM messages 
WHERE group_id = $1 
  AND ($2 = 0 OR id < $2)  -- 游标条件，避免OFFSET
  AND is_deleted = false
ORDER BY id DESC 
LIMIT 51; -- 查询51条，判断是否有更多数据

-- 2. 批量操作减少数据库往返
-- 批量标记已读（一次更新多个用户的未读状态）
UPDATE group_members 
SET last_read_message_id = $1, 
    unread_count = GREATEST(0, unread_count - $2),
    last_read_at = NOW()
WHERE group_id = $3 AND user_id = ANY($4::bigint[]);

-- 3. 使用UPSERT避免竞态条件
INSERT INTO message_reactions (message_id, user_id, reaction_type, created_at)
VALUES ($1, $2, $3, NOW())
ON CONFLICT (message_id, user_id) 
DO UPDATE SET 
    reaction_type = EXCLUDED.reaction_type,
    created_at = NOW(),
    is_deleted = false;

-- 4. 统计查询设计（避免COUNT(*)）
-- 使用实时查询统计字段
SELECT COUNT(*) FROM group_members WHERE group_id = $1 AND is_deleted = false AND status = 'active';

-- 5. 分片查询减少锁竞争
-- 按时间分片查询最近消息
WITH recent_messages AS (
    SELECT * FROM messages 
    WHERE group_id = $1 
      AND created_at > NOW() - INTERVAL '24 hours'
      AND is_deleted = false
    ORDER BY created_at DESC 
    LIMIT 20
)
SELECT * FROM recent_messages ORDER BY created_at ASC;
```

**事务设计策略**：

```sql
-- 1. 短事务原则 - 发送消息的事务设计
BEGIN;
-- 插入消息
INSERT INTO messages (message_id, group_id, sender_id, content, message_type, created_at)
VALUES ($1, $2, $3, $4, $5, NOW());

-- 异步统计更新（通过触发器自动处理）
-- 不在事务中进行复杂的统计计算
COMMIT;

-- 2. 乐观锁 - 避免长时间锁定
UPDATE group_members 
SET unread_count = unread_count + 1,
    updated_at = NOW()
WHERE group_id = $1 
  AND user_id = $2 
  AND updated_at = $3  -- 乐观锁版本检查
  AND is_deleted = false;

-- 3. 分布式锁 - 关键操作的并发控制
-- 使用Redis实现分布式锁
SET group_lock:$group_id "locked" EX 10 NX;
-- 执行关键操作（如群组解散、转让群主）
DEL group_lock:$group_id;
```

**死锁预防策略**：

```sql
-- 1. 统一锁定顺序 - 按ID升序锁定资源
-- 错误示例：可能导致死锁
UPDATE groups SET ... WHERE id = $larger_id;
UPDATE groups SET ... WHERE id = $smaller_id;

-- 正确示例：按ID升序锁定
UPDATE groups SET ... WHERE id = $smaller_id;
UPDATE groups SET ... WHERE id = $larger_id;

-- 2. 减少锁定范围 - 只锁定必要的行
UPDATE group_members 
SET last_read_message_id = $1
WHERE group_id = $2 AND user_id = $3  -- 精确条件，减少锁定范围
  AND is_deleted = false;

-- 3. 使用SELECT FOR UPDATE SKIP LOCKED
-- 处理队列任务时避免锁等待
SELECT * FROM message_queue 
WHERE status = 'pending'
ORDER BY created_at
LIMIT 10
FOR UPDATE SKIP LOCKED;
```

#### 4.3.3 缓存策略

**多层缓存架构要求**：
- L1缓存：应用内存缓存（最近消息）
- L2缓存：Redis缓存（热点群组消息）
- L3缓存：数据库查询结果缓存

**缓存更新策略**：
- 新消息发送时，异步更新相关缓存
- 使用消息队列通知缓存失效
- 缓存预热：提前加载热点群组消息

#### 4.3.4 查询设计实践

**游标分页设计要求**：
- 使用高效的游标分页查询
- 支持游标条件判断和数据预取
- 实现分页状态管理

**批量操作设计要求**：
- 支持批量数据更新操作
- 减少数据库往返次数
- 优化高频操作的性能

#### 4.3.5 监控和维护策略

**关键性能指标（KPI）监控**：

```sql
-- 1. 数据库性能指标
-- 查询响应时间监控
SELECT 
    schemaname,
    tablename,
    attname,
    n_distinct,
    correlation
FROM pg_stats 
WHERE tablename IN ('messages', 'groups', 'group_members');

-- 索引使用率监控
SELECT 
    schemaname,
    tablename,
    indexname,
    idx_scan,
    idx_tup_read,
    idx_tup_fetch
FROM pg_stat_user_indexes 
WHERE schemaname = 'public'
ORDER BY idx_scan DESC;

-- 表大小和增长趋势监控
SELECT 
    schemaname,
    tablename,
    pg_size_pretty(pg_total_relation_size(schemaname||'.'||tablename)) as size,
    pg_total_relation_size(schemaname||'.'||tablename) as size_bytes
FROM pg_tables 
WHERE schemaname = 'public'
ORDER BY size_bytes DESC;

-- 2. 业务指标监控
-- 消息发送量统计
SELECT 
    DATE(created_at) as date,
    COUNT(*) as message_count,
    COUNT(DISTINCT group_id) as active_groups,
    COUNT(DISTINCT sender_id) as active_users
FROM messages 
WHERE created_at >= CURRENT_DATE - INTERVAL '7 days'
  AND is_deleted = false
GROUP BY DATE(created_at)
ORDER BY date DESC;

-- 群组活跃度统计
SELECT 
    g.group_id,
    g.name,
    (SELECT COUNT(*) FROM group_members gm WHERE gm.group_id = g.id AND gm.is_deleted = false AND gm.status = 'active') as member_count,
    COUNT(m.id) as message_count_24h,
    MAX(m.created_at) as last_message_at
FROM groups g
LEFT JOIN messages m ON g.id = m.group_id 
    AND m.created_at >= NOW() - INTERVAL '24 hours'
    AND m.is_deleted = false
WHERE g.is_deleted = false
GROUP BY g.group_id, g.name
ORDER BY message_count_24h DESC
LIMIT 20;

-- 3. 系统健康检查
-- 连接数监控
SELECT 
    state,
    COUNT(*) as connection_count
FROM pg_stat_activity 
WHERE datname = current_database()
GROUP BY state;

-- 锁等待监控
SELECT 
    blocked_locks.pid AS blocked_pid,
    blocked_activity.usename AS blocked_user,
    blocking_locks.pid AS blocking_pid,
    blocking_activity.usename AS blocking_user,
    blocked_activity.query AS blocked_statement,
    blocking_activity.query AS blocking_statement
FROM pg_catalog.pg_locks blocked_locks
JOIN pg_catalog.pg_stat_activity blocked_activity ON blocked_activity.pid = blocked_locks.pid
JOIN pg_catalog.pg_locks blocking_locks ON blocking_locks.locktype = blocked_locks.locktype
    AND blocking_locks.database IS NOT DISTINCT FROM blocked_locks.database
    AND blocking_locks.relation IS NOT DISTINCT FROM blocked_locks.relation
    AND blocking_locks.page IS NOT DISTINCT FROM blocked_locks.page
    AND blocking_locks.tuple IS NOT DISTINCT FROM blocked_locks.tuple
    AND blocking_locks.virtualxid IS NOT DISTINCT FROM blocked_locks.virtualxid
    AND blocking_locks.transactionid IS NOT DISTINCT FROM blocked_locks.transactionid
    AND blocking_locks.classid IS NOT DISTINCT FROM blocked_locks.classid
    AND blocking_locks.objid IS NOT DISTINCT FROM blocked_locks.objid
    AND blocking_locks.objsubid IS NOT DISTINCT FROM blocked_locks.objsubid
    AND blocking_locks.pid != blocked_locks.pid
JOIN pg_catalog.pg_stat_activity blocking_activity ON blocking_activity.pid = blocking_locks.pid
WHERE NOT blocked_locks.granted;
```

**自动化维护任务**：

```sql
-- 1. 定期统计信息更新（每日执行）
DO $$
BEGIN
    -- 更新表统计信息
    ANALYZE messages;
    ANALYZE groups;
    ANALYZE group_members;
    ANALYZE user_activity;
    
    -- 记录维护日志
