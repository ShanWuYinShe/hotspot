    id BIGSERIAL PRIMARY KEY,
    message_id TEXT UNIQUE NOT NULL DEFAULT generate_unique_id(),
    group_id BIGINT NOT NULL,
    sender_id BIGINT,
    content TEXT NOT NULL,
    message_type message_type_enum NOT NULL DEFAULT 'text',
    system_event_type TEXT,
    reply_to_message_id BIGINT,
    thread_id BIGINT,
    is_edited BOOLEAN NOT NULL DEFAULT false,
    is_deleted BOOLEAN NOT NULL DEFAULT false,
    deleted_for_everyone BOOLEAN NOT NULL DEFAULT false,
    reaction_count INTEGER NOT NULL DEFAULT 0,
    reply_count INTEGER NOT NULL DEFAULT 0,
    metadata JSONB DEFAULT '{}',
    mentioned_users BIGINT[] DEFAULT '{}',
    affected_users BIGINT[] DEFAULT '{}',
    created_at TIMESTAMP WITH TIME ZONE NOT NULL DEFAULT NOW(),
    updated_at TIMESTAMP WITH TIME ZONE NOT NULL DEFAULT NOW(),
    edited_at TIMESTAMP WITH TIME ZONE,
    deleted_at TIMESTAMP WITH TIME ZONE
) PARTITION BY RANGE (created_at);

CREATE INDEX IF NOT EXISTS idx_messages_group_time_covering 
ON messages (group_id, created_at DESC) 
INCLUDE (id, message_id, sender_id, content, message_type) 
WHERE is_deleted = false;

CREATE INDEX IF NOT EXISTS idx_messages_sender_time 
ON messages (sender_id, created_at DESC) 
WHERE sender_id IS NOT NULL AND is_deleted = false;

CREATE INDEX IF NOT EXISTS idx_messages_message_id 
ON messages (message_id) 
WHERE is_deleted = false;

CREATE INDEX IF NOT EXISTS idx_messages_reply_thread 
ON messages (reply_to_message_id, thread_id) 
WHERE (reply_to_message_id IS NOT NULL OR thread_id IS NOT NULL) AND is_deleted = false;

CREATE INDEX IF NOT EXISTS idx_messages_system_events 
ON messages (group_id, system_event_type, created_at DESC) 
WHERE message_type = 'system' AND is_deleted = false;
```

