-- 创建性能监控视图
CREATE OR REPLACE VIEW performance_metrics AS
SELECT 
    'query_response_time' as metric_name,
    EXTRACT(EPOCH FROM (NOW() - query_start)) as value,
    'seconds' as unit,
    CASE 
        WHEN EXTRACT(EPOCH FROM (NOW() - query_start)) > 5 THEN 'critical'
        WHEN EXTRACT(EPOCH FROM (NOW() - query_start)) > 2 THEN 'warning'
        ELSE 'normal'
    END as status
FROM pg_stat_activity 
WHERE state = 'active' AND query NOT LIKE '%pg_stat_activity%'

UNION ALL

SELECT 
    'connection_usage' as metric_name,
    (COUNT(*)::float / (SELECT setting::int FROM pg_settings WHERE name = 'max_connections')) * 100 as value,
    'percentage' as unit,
    CASE 
        WHEN (COUNT(*)::float / (SELECT setting::int FROM pg_settings WHERE name = 'max_connections')) * 100 > 80 THEN 'critical'
        WHEN (COUNT(*)::float / (SELECT setting::int FROM pg_settings WHERE name = 'max_connections')) * 100 > 60 THEN 'warning'
        ELSE 'normal'
    END as status
FROM pg_stat_activity

UNION ALL

SELECT 
    'table_bloat' as metric_name,
    pg_total_relation_size('messages') / (1024*1024*1024) as value,
    'GB' as unit,
    CASE 
        WHEN pg_total_relation_size('messages') / (1024*1024*1024) > 100 THEN 'critical'
        WHEN pg_total_relation_size('messages') / (1024*1024*1024) > 50 THEN 'warning'
        ELSE 'normal'
    END as status;

-- 告警检查函数
CREATE OR REPLACE FUNCTION check_performance_alerts()
RETURNS TABLE(alert_type TEXT, message TEXT, severity TEXT) AS $$
BEGIN
    RETURN QUERY
    SELECT 
        pm.metric_name,
        'Metric ' || pm.metric_name || ' is ' || pm.status || ' with value: ' || pm.value || ' ' || pm.unit,
        pm.status
    FROM performance_metrics pm
    WHERE pm.status IN ('warning', 'critical');
END;
$$ LANGUAGE plpgsql;
