#### 4.3.7 数据库触发器和函数

**自动维护统计数据的触发器**：

```sql
-- 自动维护群组统计信息的函数
CREATE OR REPLACE FUNCTION update_group_stats()
RETURNS TRIGGER AS $$
BEGIN
    -- 处理消息插入
    IF TG_OP = 'INSERT' AND TG_TABLE_NAME = 'messages' THEN
        -- 维护群组最后活跃时间
        UPDATE groups 
        SET last_active_at = NEW.created_at,
            updated_at = NOW()
        WHERE id = NEW.group_id;
        
        -- 维护群组成员未读数量（除发送者外）
        UPDATE group_members 
        SET unread_count = unread_count + 1,
            updated_at = NOW()
        WHERE group_id = NEW.group_id 
          AND user_id != COALESCE(NEW.sender_id, 0)
          AND is_deleted = false
          AND status = 'active';
        
        RETURN NEW;
    END IF;
    
    -- 处理群组成员变化
    IF TG_TABLE_NAME = 'group_members' THEN
        IF TG_OP = 'INSERT' THEN
            -- 新成员加入，更新群组活跃时间
            UPDATE groups 
            SET updated_at = NOW()
            WHERE id = NEW.group_id;
            RETURN NEW;
        ELSIF TG_OP = 'UPDATE' THEN
            -- 成员状态变化，更新群组活跃时间
            IF OLD.status != NEW.status THEN
                UPDATE groups 
                SET updated_at = NOW()
                WHERE id = NEW.group_id;
            END IF;
            RETURN NEW;
        ELSIF TG_OP = 'DELETE' THEN
            -- 成员被删除，更新群组活跃时间
            UPDATE groups 
            SET updated_at = NOW()
            WHERE id = OLD.group_id;
            RETURN OLD;
        END IF;
    END IF;
    
    RETURN NULL;
END;
$$ LANGUAGE plpgsql;

-- 创建触发器
CREATE TRIGGER trigger_update_group_stats_on_message
    AFTER INSERT ON messages
    FOR EACH ROW EXECUTE FUNCTION update_group_stats();

CREATE TRIGGER trigger_update_group_stats_on_member_insert
    AFTER INSERT ON group_members
    FOR EACH ROW EXECUTE FUNCTION update_group_stats();

CREATE TRIGGER trigger_update_group_stats_on_member_update
    AFTER UPDATE ON group_members
    FOR EACH ROW EXECUTE FUNCTION update_group_stats();

CREATE TRIGGER trigger_update_group_stats_on_member_delete
    AFTER DELETE ON group_members
    FOR EACH ROW EXECUTE FUNCTION update_group_stats();

-- 软删除触发器函数
CREATE OR REPLACE FUNCTION soft_delete_cascade()
RETURNS TRIGGER AS $$
BEGIN
    -- 当群组被软删除时，软删除相关数据
    IF TG_TABLE_NAME = 'groups' AND NEW.is_deleted = true AND OLD.is_deleted = false THEN
        -- 软删除群组成员
        UPDATE group_members 
        SET is_deleted = true, deleted_at = NOW()
        WHERE group_id = NEW.id AND is_deleted = false;
        
        -- 软删除群组消息
        UPDATE messages 
        SET is_deleted = true, deleted_at = NOW()
        WHERE group_id = NEW.id AND is_deleted = false;
    END IF;
    
    -- 当用户被软删除时，软删除相关数据
    IF TG_TABLE_NAME = 'users' AND NEW.is_deleted = true AND OLD.is_deleted = false THEN
        -- 软删除用户的群组成员关系
        UPDATE group_members 
        SET is_deleted = true, deleted_at = NOW()
        WHERE user_id = NEW.id AND is_deleted = false;
        
        -- 软删除用户发送的消息
        UPDATE messages 
        SET is_deleted = true, deleted_at = NOW()
        WHERE sender_id = NEW.id AND is_deleted = false;
    END IF;
    
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

-- 创建软删除触发器
CREATE TRIGGER trigger_soft_delete_groups
    AFTER UPDATE ON groups
    FOR EACH ROW EXECUTE FUNCTION soft_delete_cascade();

CREATE TRIGGER trigger_soft_delete_users
    AFTER UPDATE ON users
    FOR EACH ROW EXECUTE FUNCTION soft_delete_cascade();

-- 自动分区管理函数
CREATE OR REPLACE FUNCTION create_monthly_partition(table_name TEXT, start_date DATE)
RETURNS VOID AS $$
DECLARE
    partition_name TEXT;
    end_date DATE;
BEGIN
    partition_name := table_name || '_' || to_char(start_date, 'YYYY_MM');
    end_date := start_date + INTERVAL '1 month';
    
    EXECUTE format('CREATE TABLE IF NOT EXISTS %I PARTITION OF %I 
                    FOR VALUES FROM (%L) TO (%L)',
                   partition_name, table_name, start_date, end_date);
    
    -- 为新分区创建索引
    IF table_name = 'messages' THEN
        EXECUTE format('CREATE INDEX CONCURRENTLY IF NOT EXISTS idx_%s_group_time_covering 
                        ON %I (group_id, created_at DESC) 
                        INCLUDE (id, message_id, sender_id, content, message_type) 
                        WHERE is_deleted = false',
                       partition_name, partition_name);
    END IF;
END;
$$ LANGUAGE plpgsql;

-- 自动创建下个月分区的函数
CREATE OR REPLACE FUNCTION auto_create_partitions()
RETURNS VOID AS $$
DECLARE
    next_month DATE;
BEGIN
    next_month := date_trunc('month', CURRENT_DATE + INTERVAL '1 month');
    PERFORM create_monthly_partition('messages', next_month);
    PERFORM create_monthly_partition('user_activity', next_month);
END;
$$ LANGUAGE plpgsql;
```

