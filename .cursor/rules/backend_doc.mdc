);

-- 索引
CREATE INDEX IF NOT EXISTS idx_users_login_id ON users(login_id) WHERE is_deleted = false;
CREATE INDEX IF NOT EXISTS idx_users_active ON users(updated_at DESC) WHERE is_deleted = false AND is_active = true;
