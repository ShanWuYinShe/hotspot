**4. 应用层关联验证** 🔒

```rust
// 在应用层实现外键约束的逻辑验证
pub async fn create_message(
    pool: &PgPool,
    group_id: i64,
    sender_id: i64,
    content: &str,
) -> Result<Message, Error> {
    let mut tx = pool.begin().await?;
    
    // 1. 验证群组存在且用户有权限
    let group_member = sqlx::query!(
        "SELECT role, can_send_messages 
         FROM group_members 
         WHERE group_id = $1 AND user_id = $2 AND is_deleted = false",
        group_id, sender_id
    )
    .fetch_optional(&mut *tx)
    .await?
    .ok_or(Error::NotGroupMember)?;
    
    if !group_member.can_send_messages {
        return Err(Error::NoSendPermission);
    }
    
    // 2. 插入消息（优化器知道group_id和sender_id都是有效的）
    let message = sqlx::query_as!(
        Message,
        "INSERT INTO messages (group_id, sender_id, content, created_at)
         VALUES ($1, $2, $3, NOW())
         RETURNING *",
        group_id, sender_id, content
    )
    .fetch_one(&mut *tx)
    .await?;
    
    tx.commit().await?;
    Ok(message)
}
```

**5. 数据分布统计** 📈

```sql
-- 创建自定义统计视图，帮助优化器理解数据分布
CREATE VIEW table_relationships AS
SELECT 
    'messages_to_groups' as relationship,
    COUNT(DISTINCT m.group_id) as distinct_groups,
    COUNT(*) as total_messages,
    AVG(group_message_count) as avg_messages_per_group
FROM messages m
JOIN (
    SELECT group_id, COUNT(*) as group_message_count
    FROM messages 
    WHERE is_deleted = false
    GROUP BY group_id
) gmc ON m.group_id = gmc.group_id
WHERE m.is_deleted = false;

-- 定期收集关联统计信息
CREATE OR REPLACE FUNCTION update_relationship_stats()
RETURNS void AS $$
BEGIN
    -- 维护消息-群组关联统计
    INSERT INTO relationship_stats (table_pair, selectivity, last_updated)
    VALUES (
        'messages_groups',
        (SELECT COUNT(DISTINCT group_id)::float / COUNT(*) FROM messages),
        NOW()
    )
    ON CONFLICT (table_pair) 
    DO UPDATE SET 
        selectivity = EXCLUDED.selectivity,
        last_updated = EXCLUDED.last_updated;
END;
$$ LANGUAGE plpgsql;
